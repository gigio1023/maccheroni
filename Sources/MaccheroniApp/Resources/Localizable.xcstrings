    "Rename this speaker everywhere in this transcript." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Benennen Sie diesen Sprecher überall in diesem Transkript um."}},"en":{"stringUnit":{"state":"needs_review","value":"Rename this speaker everywhere in this transcript."}},"es":{"stringUnit":{"state":"translated","value":"Cambie el nombre de este hablante en toda esta transcripción."}},"fr":{"stringUnit":{"state":"translated","value":"Renommez cet intervenant partout dans cette transcription."}},"it":{"stringUnit":{"state":"needs_review","value":"Rinomina questo parlante ovunque in questa trascrizione."}},"ja":{"stringUnit":{"state":"translated","value":"このトランスクリプト内のこの話者名をすべて変更します。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 전사문 전체에서 이 화자 이름을 바꿉니다."}},"pt":{"stringUnit":{"state":"translated","value":"Renomeie este falante em toda esta transcrição."}},"ru":{"stringUnit":{"state":"translated","value":"Переименовать этого говорящего во всей этой расшифровке."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在此转录文本中所有位置重命名此发言人。"}}}},

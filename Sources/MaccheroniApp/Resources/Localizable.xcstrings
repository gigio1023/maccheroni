    "Transcript layer: Speaker-labelled" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Transkriptebene: Mit Sprecherzuordnung"}},"en":{"stringUnit":{"state":"needs_review","value":"Transcript layer: Speaker-labelled"}},"es":{"stringUnit":{"state":"translated","value":"Capa de transcripción: Con hablantes etiquetados"}},"fr":{"stringUnit":{"state":"translated","value":"Couche de transcription : Avec locuteurs identifiés"}},"it":{"stringUnit":{"state":"needs_review","value":"Livello della trascrizione: con parlanti etichettati"}},"ja":{"stringUnit":{"state":"translated","value":"文字起こしレイヤー：話者ラベル付き"}},"ko":{"stringUnit":{"state":"needs_review","value":"전사문 레이어: 화자 레이블 포함"}},"pt":{"stringUnit":{"state":"translated","value":"Camada da transcrição: Com falantes identificados"}},"ru":{"stringUnit":{"state":"translated","value":"Слой расшифровки: С обозначением говорящих"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转录层：已标注说话人"}}}},
    "Transcript layer: Corrected" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Transkriptebene: Korrigiert"}},"en":{"stringUnit":{"state":"needs_review","value":"Transcript layer: Corrected"}},"es":{"stringUnit":{"state":"translated","value":"Capa de transcripción: Corregida"}},"fr":{"stringUnit":{"state":"translated","value":"Couche de transcription : Corrigée"}},"it":{"stringUnit":{"state":"needs_review","value":"Livello della trascrizione: corretta"}},"ja":{"stringUnit":{"state":"translated","value":"文字起こしレイヤー：修正版"}},"ko":{"stringUnit":{"state":"needs_review","value":"전사문 레이어: 교정본"}},"pt":{"stringUnit":{"state":"translated","value":"Camada da transcrição: Corrigida"}},"ru":{"stringUnit":{"state":"translated","value":"Слой расшифровки: Исправленная"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转录层：已校正"}}}},

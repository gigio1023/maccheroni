    "Move Model to Trash" : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Modell in den Papierkorb verschieben"}},"en":{"stringUnit":{"state":"needs_review","value":"Move Model to Trash"}},"es":{"stringUnit":{"state":"translated","value":"Mover modelo a la papelera"}},"fr":{"stringUnit":{"state":"translated","value":"Déplacer le modèle vers la corbeille"}},"it":{"stringUnit":{"state":"needs_review","value":"Sposta il modello nel cestino"}},"ja":{"stringUnit":{"state":"translated","value":"モデルをゴミ箱に移動"}},"ko":{"stringUnit":{"state":"needs_review","value":"모델을 휴지통으로 이동"}},"pt":{"stringUnit":{"state":"translated","value":"Mover modelo para a lixeira"}},"ru":{"stringUnit":{"state":"translated","value":"Переместить модель в корзину"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将模型移至垃圾箱"}}}

    "Show this layer of the transcript." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Ebene des Transkripts anzeigen."}},"en":{"stringUnit":{"state":"needs_review","value":"Show this layer of the transcript."}},"es":{"stringUnit":{"state":"translated","value":"Muestra esta capa de la transcripción."}},"fr":{"stringUnit":{"state":"translated","value":"Affiche cette couche de la transcription."}},"it":{"stringUnit":{"state":"needs_review","value":"Mostra questo livello della trascrizione."}},"ja":{"stringUnit":{"state":"translated","value":"文字起こしのこのレイヤーを表示します。"}},"ko":{"stringUnit":{"state":"needs_review","value":"전사문의 이 레이어를 표시합니다."}},"pt":{"stringUnit":{"state":"translated","value":"Mostra esta camada da transcrição."}},"ru":{"stringUnit":{"state":"translated","value":"Показать этот слой расшифровки."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"显示转录文本的此图层。"}}}},
    "Speaker Separation" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprechertrennung"}},"en":{"stringUnit":{"state":"needs_review","value":"Speaker Separation"}},"es":{"stringUnit":{"state":"translated","value":"Separación de hablantes"}},"fr":{"stringUnit":{"state":"translated","value":"Séparation des locuteurs"}},"it":{"stringUnit":{"state":"needs_review","value":"Separazione dei parlanti"}},"ja":{"stringUnit":{"state":"translated","value":"話者分離"}},"ko":{"stringUnit":{"state":"needs_review","value":"화자 분리"}},"pt":{"stringUnit":{"state":"translated","value":"Separação de falantes"}},"ru":{"stringUnit":{"state":"translated","value":"Разделение говорящих"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"说话人分离"}}}},
    "Speaker not attributed yet" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprecher noch nicht zugeordnet"}},"en":{"stringUnit":{"state":"needs_review","value":"Speaker not attributed yet"}},"es":{"stringUnit":{"state":"translated","value":"Hablante aún sin atribuir"}},"fr":{"stringUnit":{"state":"translated","value":"Locuteur pas encore attribué"}},"it":{"stringUnit":{"state":"needs_review","value":"Parlante non ancora attribuito"}},"ja":{"stringUnit":{"state":"translated","value":"話者は未割り当てです"}},"ko":{"stringUnit":{"state":"needs_review","value":"화자 미배정"}},"pt":{"stringUnit":{"state":"translated","value":"Falante ainda não atribuído"}},"ru":{"stringUnit":{"state":"translated","value":"Говорящий ещё не сопоставлен"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"尚未归属说话人"}}}},
    "Speaker not named" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprecher nicht benannt"}},"en":{"stringUnit":{"state":"needs_review","value":"Speaker not named"}},"es":{"stringUnit":{"state":"translated","value":"Hablante sin nombrar"}},"fr":{"stringUnit":{"state":"translated","value":"Locuteur non nommé"}},"it":{"stringUnit":{"state":"needs_review","value":"Parlante non indicato"}},"ja":{"stringUnit":{"state":"translated","value":"話者は特定されていません"}},"ko":{"stringUnit":{"state":"needs_review","value":"화자 미확정"}},"pt":{"stringUnit":{"state":"translated","value":"Falante não indicado"}},"ru":{"stringUnit":{"state":"translated","value":"Говорящий не назван"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未确定说话人"}}}},
    "Speaker separation returned a speaker timeline Maccheroni cannot trust, so the run stopped before transcription." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Sprecherdiarisierung lieferte eine Zeitleiste, der Maccheroni nicht vertrauen kann; der Lauf wurde vor der Transkription angehalten."}},"en":{"stringUnit":{"state":"needs_review","value":"Speaker separation returned a speaker timeline Maccheroni cannot trust, so the run stopped before transcription."}},"es":{"stringUnit":{"state":"translated","value":"La diarización de hablantes devolvió una línea de tiempo en la que Maccheroni no puede confiar, así que la ejecución se detuvo antes de la transcripción."}},"fr":{"stringUnit":{"state":"translated","value":"La diarisation des locuteurs a renvoyé une chronologie à laquelle Maccheroni ne peut pas se fier ; l’exécution s’est arrêtée avant la transcription."}},"it":{"stringUnit":{"state":"needs_review","value":"La diarizzazione dei parlanti ha restituito una timeline che Maccheroni non può ritenere affidabile, quindi l'esecuzione si è fermata prima della trascrizione."}},"ja":{"stringUnit":{"state":"translated","value":"スピーカーのダイアライゼーションが Maccheroni の信頼できない話者タイムラインを返したため、転写の前に実行が停止しました。"}},"ko":{"stringUnit":{"state":"needs_review","value":"화자 분리가 Maccheroni가 신뢰할 수 없는 화자 타임라인을 내놓아 전사 전에 실행이 멈췄습니다."}},"pt":{"stringUnit":{"state":"translated","value":"A diarização de falantes devolveu uma linha do tempo em que o Maccheroni não pode confiar, então a execução parou antes da transcrição."}},"ru":{"stringUnit":{"state":"translated","value":"Диаризация говорящих вернула таймлайн, которому Maccheroni не может доверять, поэтому запуск остановился до транскрипции."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"说话人分离返回了 Maccheroni 无法信任的说话人时间轴，因此运行在转录前停止。"}}}},
    "Speakers" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprecher"}},"en":{"stringUnit":{"state":"needs_review","value":"Speakers"}},"es":{"stringUnit":{"state":"translated","value":"Hablantes"}},"fr":{"stringUnit":{"state":"translated","value":"Locuteurs"}},"it":{"stringUnit":{"state":"needs_review","value":"Parlanti"}},"ja":{"stringUnit":{"state":"translated","value":"話者"}},"ko":{"stringUnit":{"state":"needs_review","value":"화자"}},"pt":{"stringUnit":{"state":"translated","value":"Falantes"}},"ru":{"stringUnit":{"state":"translated","value":"Говорящие"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"说话人"}}}},
    "Speech Recognition" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Spracherkennung"}},"en":{"stringUnit":{"state":"needs_review","value":"Speech Recognition"}},"es":{"stringUnit":{"state":"translated","value":"Reconocimiento de voz"}},"fr":{"stringUnit":{"state":"translated","value":"Reconnaissance vocale"}},"it":{"stringUnit":{"state":"needs_review","value":"Riconoscimento vocale"}},"ja":{"stringUnit":{"state":"translated","value":"音声認識"}},"ko":{"stringUnit":{"state":"needs_review","value":"음성 인식"}},"pt":{"stringUnit":{"state":"translated","value":"Reconhecimento de voz"}},"ru":{"stringUnit":{"state":"translated","value":"Распознавание речи"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"语音识别"}}}},
    "Speech recognition ran past the time budget for this audio and was stopped." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Spracherkennung hat das Zeitbudget für dieses Audio überschritten und wurde gestoppt."}},"en":{"stringUnit":{"state":"needs_review","value":"Speech recognition ran past the time budget for this audio and was stopped."}},"es":{"stringUnit":{"state":"translated","value":"El reconocimiento de voz superó el tiempo previsto para este audio y se detuvo."}},"fr":{"stringUnit":{"state":"translated","value":"La reconnaissance vocale a dépassé le temps alloué à cet audio et a été arrêtée."}},"it":{"stringUnit":{"state":"needs_review","value":"Il riconoscimento vocale ha superato il tempo previsto per questo audio ed è stato interrotto."}},"ja":{"stringUnit":{"state":"translated","value":"音声認識がこのオーディオの時間予算を超えたため停止されました。"}},"ko":{"stringUnit":{"state":"needs_review","value":"음성 인식이 이 오디오에 배정된 시간을 넘겨 중단되었습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O reconhecimento de fala ultrapassou o tempo previsto para este áudio e foi interrompido."}},"ru":{"stringUnit":{"state":"translated","value":"Распознавание речи превысило отведённое на это аудио время и было остановлено."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"语音识别超出了这段音频的时间预算，已被停止。"}}}},
    "Speech recognition reached the MOSS output limit even after the failed range had been split into smaller pieces." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Spracherkennung erreichte das MOSS-Ausgabelimit auch nach dem Aufteilen des fehlgeschlagenen Bereichs in kleinere Teile."}},"en":{"stringUnit":{"state":"needs_review","value":"Speech recognition reached the MOSS output limit even after the failed range had been split into smaller pieces."}},"es":{"stringUnit":{"state":"translated","value":"El reconocimiento de voz alcanzó el límite de salida de MOSS incluso después de dividir el intervalo fallido en partes más pequeñas."}},"fr":{"stringUnit":{"state":"translated","value":"La reconnaissance vocale a atteint la limite de sortie de MOSS même après le découpage de la plage en échec en fragments plus petits."}},"it":{"stringUnit":{"state":"needs_review","value":"Il riconoscimento vocale ha raggiunto il limite di output di MOSS anche dopo che l'intervallo non riuscito era stato suddiviso in parti più piccole."}},"ja":{"stringUnit":{"state":"translated","value":"失敗した範囲をより小さく分割した後も、音声認識は MOSS の出力上限に達しました。"}},"ko":{"stringUnit":{"state":"needs_review","value":"실패한 구간을 더 작게 나눈 뒤에도 음성 인식이 MOSS 출력 한도에 도달했습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O reconhecimento de fala atingiu o limite de saída do MOSS mesmo depois de o intervalo com falha ter sido dividido em partes menores."}},"ru":{"stringUnit":{"state":"translated","value":"Распознавание речи достигло предела вывода MOSS даже после разбиения неудавшегося диапазона на меньшие части."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"即使把失败区间拆分为更小的片段，语音识别仍达到 MOSS 的输出上限。"}}}},
    "Speech recognition reached the output limit for this audio before it finished, and splitting the audio into smaller pieces did not bring it back under the limit." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Spracherkennung erreichte das Ausgabelimit für dieses Audio, bevor sie fertig war; auch das Aufteilen in kleinere Teile brachte sie nicht wieder unter das Limit."}},"en":{"stringUnit":{"state":"needs_review","value":"Speech recognition reached the output limit for this audio before it finished, and splitting the audio into smaller pieces did not bring it back under the limit."}},"es":{"stringUnit":{"state":"translated","value":"El reconocimiento de voz alcanzó el límite de salida de este audio antes de terminar, y dividirlo en partes más pequeñas no lo devolvió por debajo del límite."}},"fr":{"stringUnit":{"state":"translated","value":"La reconnaissance vocale a atteint la limite de sortie de cet audio avant la fin, et le découpage en fragments plus petits ne l’a pas ramenée sous la limite."}},"it":{"stringUnit":{"state":"needs_review","value":"Il riconoscimento vocale ha raggiunto il limite di output per questo audio prima di finire, e suddividerlo in parti più piccole non lo ha riportato sotto il limite."}},"ja":{"stringUnit":{"state":"translated","value":"音声認識はこのオーディオを終える前に出力上限に達し、オーディオを小さく分割しても上限を下回りませんでした。"}},"ko":{"stringUnit":{"state":"needs_review","value":"음성 인식이 이 오디오를 끝내기 전에 출력 한도에 도달했고, 오디오를 더 작게 나눠도 한도 아래로 내려가지 않았습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O reconhecimento de fala atingiu o limite de saída deste áudio antes de terminar, e dividi-lo em partes menores não o trouxe de volta abaixo do limite."}},"ru":{"stringUnit":{"state":"translated","value":"Распознавание речи достигло предела вывода для этого аудио, не закончив работу, и разбиение аудио на меньшие части не вернуло его под предел."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"语音识别在完成这段音频前就达到了输出上限，把音频拆分为更小的片段也没有回到上限以内。"}}}},
    "Speech recognition returned output Maccheroni could not verify, so nothing was promoted into the transcript." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Spracherkennung lieferte eine Ausgabe, die Maccheroni nicht prüfen konnte; nichts davon wurde ins Transkript übernommen."}},"en":{"stringUnit":{"state":"needs_review","value":"Speech recognition returned output Maccheroni could not verify, so nothing was promoted into the transcript."}},"es":{"stringUnit":{"state":"translated","value":"El reconocimiento de voz devolvió una salida que Maccheroni no pudo verificar, así que no se promovió nada a la transcripción."}},"fr":{"stringUnit":{"state":"translated","value":"La reconnaissance vocale a renvoyé une sortie que Maccheroni n’a pas pu vérifier ; rien n’a été retenu dans la transcription."}},"it":{"stringUnit":{"state":"needs_review","value":"Il riconoscimento vocale ha restituito un output che Maccheroni non ha potuto verificare, quindi nulla è stato promosso nella trascrizione."}},"ja":{"stringUnit":{"state":"translated","value":"音声認識が Maccheroni では検証できない出力を返したため、文字起こしには何も反映されませんでした。"}},"ko":{"stringUnit":{"state":"needs_review","value":"음성 인식이 Maccheroni가 검증할 수 없는 출력을 내놓아 전사문에 아무것도 반영되지 않았습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O reconhecimento de fala devolveu uma saída que o Maccheroni não pôde verificar, então nada foi promovido para a transcrição."}},"ru":{"stringUnit":{"state":"translated","value":"Распознавание речи вернуло вывод, который Maccheroni не смог проверить, поэтому в расшифровку ничего не попало."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"语音识别返回了 Maccheroni 无法验证的输出，因此没有任何内容进入转录文本。"}}}},
    "Speech recognition stopped producing new words and repeated itself to the end of its output budget, so that stretch of audio produced no usable text." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Spracherkennung erzeugte keine neuen Wörter mehr und wiederholte sich bis zum Ende ihres Ausgabebudgets; dieser Abschnitt lieferte daher keinen brauchbaren Text."}},"en":{"stringUnit":{"state":"needs_review","value":"Speech recognition stopped producing new words and repeated itself to the end of its output budget, so that stretch of audio produced no usable text."}},"es":{"stringUnit":{"state":"translated","value":"El reconocimiento de voz dejó de producir palabras nuevas y se repitió hasta agotar su presupuesto de salida, por lo que ese tramo de audio no dio texto utilizable."}},"fr":{"stringUnit":{"state":"translated","value":"La reconnaissance vocale a cessé de produire de nouveaux mots et s’est répétée jusqu’à épuiser son budget de sortie ; ce passage n’a donc donné aucun texte exploitable."}},"it":{"stringUnit":{"state":"needs_review","value":"Il riconoscimento vocale ha smesso di produrre parole nuove e si è ripetuto fino a esaurire il budget di output, quindi quel tratto di audio non ha prodotto testo utilizzabile."}},"ja":{"stringUnit":{"state":"translated","value":"音声認識が新しい語を出さなくなり、出力予算の終わりまで同じ語を繰り返したため、その区間からは使えるテキストが得られませんでした。"}},"ko":{"stringUnit":{"state":"needs_review","value":"음성 인식이 새 단어를 내놓기를 멈추고 출력 한도 끝까지 같은 말을 반복해서, 그 구간에서는 쓸 만한 텍스트가 나오지 않았습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O reconhecimento de fala parou de produzir palavras novas e repetiu-se até esgotar o orçamento de saída, então esse trecho de áudio não gerou texto utilizável."}},"ru":{"stringUnit":{"state":"translated","value":"Распознавание речи перестало выдавать новые слова и повторялось до исчерпания бюджета вывода, поэтому этот отрезок аудио не дал пригодного текста."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"语音识别不再产生新词，而是重复同一内容直到用尽输出预算，因此那段音频没有产生可用文本。"}}}},
    "Stopped At" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Angehalten bei"}},"en":{"stringUnit":{"state":"needs_review","value":"Stopped At"}},"es":{"stringUnit":{"state":"translated","value":"Detenido en"}},"fr":{"stringUnit":{"state":"translated","value":"Arrêté à"}},"it":{"stringUnit":{"state":"needs_review","value":"Interrotto a"}},"ja":{"stringUnit":{"state":"translated","value":"停止した段階"}},"ko":{"stringUnit":{"state":"needs_review","value":"멈춘 단계"}},"pt":{"stringUnit":{"state":"translated","value":"Parou em"}},"ru":{"stringUnit":{"state":"translated","value":"Остановлено на"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"停止阶段"}}}},
    "System audio is not recordable yet. Turn Maccheroni on in System Settings > Privacy & Security > Screen & System Audio Recording." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Systemaudio kann noch nicht aufgenommen werden. Aktivieren Sie Maccheroni unter Systemeinstellungen > Datenschutz & Sicherheit > Bildschirm- & Systemaudioaufnahme."}},"en":{"stringUnit":{"state":"needs_review","value":"System audio is not recordable yet. Turn Maccheroni on in System Settings > Privacy & Security > Screen & System Audio Recording."}},"es":{"stringUnit":{"state":"translated","value":"Todavía no se puede grabar el audio del sistema. Activa Maccheroni en Ajustes del Sistema > Privacidad y seguridad > Grabación de pantalla y audio del sistema."}},"fr":{"stringUnit":{"state":"translated","value":"L'audio du système n'est pas encore enregistrable. Activez Maccheroni dans Réglages Système > Confidentialité et sécurité > Enregistrement de l'écran et de l'audio du système."}},"it":{"stringUnit":{"state":"needs_review","value":"L'audio di sistema non è ancora registrabile. Attiva Maccheroni in Impostazioni di Sistema > Privacy e sicurezza > Registrazione schermo e audio di sistema."}},"ja":{"stringUnit":{"state":"translated","value":"システムオーディオはまだ録音できません。システム設定 > プライバシーとセキュリティ > 画面収録とシステムオーディオ録音 で Maccheroni をオンにしてください。"}},"ko":{"stringUnit":{"state":"needs_review","value":"아직 시스템 사운드를 녹음할 수 없습니다. 시스템 설정 > 개인정보 보호 및 보안 > 화면 및 시스템 오디오 기록에서 Maccheroni를 켜세요."}},"pt":{"stringUnit":{"state":"translated","value":"Ainda não é possível gravar o áudio do sistema. Ative o Maccheroni em Ajustes do Sistema > Privacidade e Segurança > Gravação de Tela e Áudio do Sistema."}},"ru":{"stringUnit":{"state":"translated","value":"Системный звук пока нельзя записывать. Включите Maccheroni в разделе «Системные настройки > Конфиденциальность и безопасность > Запись экрана и системного звука»."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"目前还无法录制系统音频。请在“系统设置 > 隐私与安全性 > 屏幕与系统音频录制”中打开 Maccheroni。"}}}},
    "The folder Maccheroni saves recordings and runs in cannot be reached." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Auf den Ordner, in dem Maccheroni Aufnahmen und Durchläufe speichert, kann nicht zugegriffen werden."}},"en":{"stringUnit":{"state":"needs_review","value":"The folder Maccheroni saves recordings and runs in cannot be reached."}},"es":{"stringUnit":{"state":"translated","value":"No se puede acceder a la carpeta en la que Maccheroni guarda las grabaciones y las ejecuciones."}},"fr":{"stringUnit":{"state":"translated","value":"Le dossier dans lequel Maccheroni enregistre les captures et les exécutions est inaccessible."}},"it":{"stringUnit":{"state":"needs_review","value":"Non è possibile raggiungere la cartella in cui Maccheroni salva registrazioni ed esecuzioni."}},"ja":{"stringUnit":{"state":"translated","value":"Maccheroni が録音と実行結果を保存するフォルダにアクセスできません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"Maccheroni가 녹음과 실행 결과를 저장하는 폴더에 접근할 수 없습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Não é possível acessar a pasta em que o Maccheroni salva gravações e execuções."}},"ru":{"stringUnit":{"state":"translated","value":"Нет доступа к папке, в которой Maccheroni сохраняет записи и результаты запусков."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法访问 Maccheroni 保存录音和运行结果的文件夹。"}}}},
    "The glossary for this profile could not be used for this run." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Glossar dieses Profils konnte für diesen Lauf nicht verwendet werden."}},"en":{"stringUnit":{"state":"needs_review","value":"The glossary for this profile could not be used for this run."}},"es":{"stringUnit":{"state":"translated","value":"El glosario de este perfil no se pudo usar en esta ejecución."}},"fr":{"stringUnit":{"state":"translated","value":"Le glossaire de ce profil n’a pas pu être utilisé pour cette exécution."}},"it":{"stringUnit":{"state":"needs_review","value":"Il glossario di questo profilo non è stato utilizzabile per questa esecuzione."}},"ja":{"stringUnit":{"state":"translated","value":"このプロフィールの用語集を今回の実行に使用できませんでした。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 프로필의 용어집을 이번 실행에 사용할 수 없었습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O glossário deste perfil não pôde ser usado nesta execução."}},"ru":{"stringUnit":{"state":"translated","value":"Глоссарий этого профиля не удалось использовать в этом запуске."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本次运行无法使用此配置文件的术语表。"}}}},
    "The glossary the source run used" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Glossar, das der Quelllauf verwendet hat"}},"en":{"stringUnit":{"state":"needs_review","value":"The glossary the source run used"}},"es":{"stringUnit":{"state":"translated","value":"El glosario que usó la ejecución de origen"}},"fr":{"stringUnit":{"state":"translated","value":"Le glossaire utilisé par l'exécution source"}},"it":{"stringUnit":{"state":"needs_review","value":"Il glossario usato dall'esecuzione di origine"}},"ja":{"stringUnit":{"state":"translated","value":"元の実行が使用した用語集"}},"ko":{"stringUnit":{"state":"needs_review","value":"원본 실행이 사용한 용어집"}},"pt":{"stringUnit":{"state":"translated","value":"O glossário que a execução de origem usou"}},"ru":{"stringUnit":{"state":"translated","value":"Глоссарий, использованный исходным запуском"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"源运行使用的术语表"}}}},
    "The local speech runtime this profile needs is missing or does not match its pinned version." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die lokale Sprachlaufzeit, die dieses Profil benötigt, fehlt oder entspricht nicht der festgelegten Version."}},"en":{"stringUnit":{"state":"needs_review","value":"The local speech runtime this profile needs is missing or does not match its pinned version."}},"es":{"stringUnit":{"state":"translated","value":"Falta el entorno de ejecución de voz local que necesita este perfil, o no coincide con su versión fijada."}},"fr":{"stringUnit":{"state":"translated","value":"L'environnement d'exécution vocal local requis par ce profil est absent ou ne correspond pas à sa version épinglée."}},"it":{"stringUnit":{"state":"needs_review","value":"Il runtime vocale locale richiesto da questo profilo manca o non corrisponde alla versione fissata."}},"ja":{"stringUnit":{"state":"translated","value":"このプロファイルに必要なローカル音声ランタイムがないか、固定されたバージョンと一致しません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 프로필에 필요한 로컬 음성 런타임이 없거나 고정된 버전과 일치하지 않습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O ambiente de execução de fala local exigido por este perfil está ausente ou não corresponde à versão fixada."}},"ru":{"stringUnit":{"state":"translated","value":"Локальная речевая среда выполнения, необходимая этому профилю, отсутствует или не совпадает с закреплённой версией."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此配置文件所需的本地语音运行时缺失，或与固定版本不一致。"}}}},
    "The original recording could not be found." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Originalaufnahme wurde nicht gefunden."}},"en":{"stringUnit":{"state":"needs_review","value":"The original recording could not be found."}},"es":{"stringUnit":{"state":"translated","value":"No se encontró la grabación original."}},"fr":{"stringUnit":{"state":"translated","value":"L'enregistrement d'origine est introuvable."}},"it":{"stringUnit":{"state":"needs_review","value":"Impossibile trovare la registrazione originale."}},"ja":{"stringUnit":{"state":"translated","value":"元の録音が見つかりませんでした。"}},"ko":{"stringUnit":{"state":"needs_review","value":"원본 녹음을 찾을 수 없습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Não foi possível encontrar a gravação original."}},"ru":{"stringUnit":{"state":"translated","value":"Исходная запись не найдена."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"找不到原始录音。"}}}},
    "The profile's current glossary" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das aktuelle Glossar des Profils"}},"en":{"stringUnit":{"state":"needs_review","value":"The profile's current glossary"}},"es":{"stringUnit":{"state":"translated","value":"El glosario actual del perfil"}},"fr":{"stringUnit":{"state":"translated","value":"Le glossaire actuel du profil"}},"it":{"stringUnit":{"state":"needs_review","value":"Il glossario corrente del profilo"}},"ja":{"stringUnit":{"state":"translated","value":"プロファイルの現在の用語集"}},"ko":{"stringUnit":{"state":"needs_review","value":"프로필의 현재 용어집"}},"pt":{"stringUnit":{"state":"translated","value":"O glossário atual do perfil"}},"ru":{"stringUnit":{"state":"translated","value":"Текущий глоссарий профиля"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该配置的当前术语表"}}}},
    "The recovered transcript, the original audio, and every completed artifact were preserved. This run is recorded as partial, not complete." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das wiederhergestellte Transkript, das Originalaudio und alle fertigen Artefakte wurden erhalten. Dieser Lauf wird als teilweise und nicht als vollständig verzeichnet."}},"en":{"stringUnit":{"state":"needs_review","value":"The recovered transcript, the original audio, and every completed artifact were preserved. This run is recorded as partial, not complete."}},"es":{"stringUnit":{"state":"translated","value":"Se conservaron la transcripción recuperada, el audio original y todos los artefactos completados. Esta ejecución queda registrada como parcial, no como completa."}},"fr":{"stringUnit":{"state":"translated","value":"La transcription récupérée, l’audio d’origine et tous les artefacts terminés ont été conservés. Cette exécution est enregistrée comme partielle, pas comme complète."}},"it":{"stringUnit":{"state":"needs_review","value":"La trascrizione recuperata, l'audio originale e tutti gli artefatti completati sono stati conservati. Questa esecuzione è registrata come parziale, non come completa."}},"ja":{"stringUnit":{"state":"translated","value":"復元された文字起こし、元のオーディオ、完了したすべての成果物は保存されました。この実行は完了ではなく部分として記録されます。"}},"ko":{"stringUnit":{"state":"needs_review","value":"복구된 전사문과 원본 오디오, 완료된 산출물을 모두 보존했습니다. 이 실행은 완료가 아니라 부분으로 기록됩니다."}},"pt":{"stringUnit":{"state":"translated","value":"A transcrição recuperada, o áudio original e todos os artefatos concluídos foram preservados. Esta execução fica registrada como parcial, não como completa."}},"ru":{"stringUnit":{"state":"translated","value":"Восстановленная расшифровка, исходное аудио и все завершённые артефакты сохранены. Этот запуск записан как частичный, а не как завершённый."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已恢复的转录文本、原始音频以及所有已完成的产物均被保留。本次运行记录为部分完成，而非完成。"}}}},
    "The run record for this transcription cannot be read, so Maccheroni cannot say what happened." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Laufaufzeichnung dieser Transkription lässt sich nicht lesen, deshalb kann Maccheroni nicht sagen, was geschehen ist."}},"en":{"stringUnit":{"state":"needs_review","value":"The run record for this transcription cannot be read, so Maccheroni cannot say what happened."}},"es":{"stringUnit":{"state":"translated","value":"No se puede leer el registro de ejecución de esta transcripción, así que Maccheroni no puede decir qué ocurrió."}},"fr":{"stringUnit":{"state":"translated","value":"L’enregistrement d’exécution de cette transcription est illisible ; Maccheroni ne peut donc pas dire ce qui s’est passé."}},"it":{"stringUnit":{"state":"needs_review","value":"Il registro dell'esecuzione di questa trascrizione non è leggibile, quindi Maccheroni non può dire che cosa sia successo."}},"ja":{"stringUnit":{"state":"translated","value":"この文字起こしの実行記録を読み取れないため、Maccheroni は何が起きたかを示せません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 전사의 실행 기록을 읽을 수 없어 Maccheroni가 무슨 일이 있었는지 말할 수 없습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O registro de execução desta transcrição não pode ser lido, então o Maccheroni não consegue dizer o que aconteceu."}},"ru":{"stringUnit":{"state":"translated","value":"Запись запуска этой расшифровки не читается, поэтому Maccheroni не может сказать, что произошло."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法读取这次转录的运行记录，因此 Maccheroni 说不出发生了什么。"}}}},
    "The run was cancelled before it finished." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der Lauf wurde vor dem Abschluss abgebrochen."}},"en":{"stringUnit":{"state":"needs_review","value":"The run was cancelled before it finished."}},"es":{"stringUnit":{"state":"translated","value":"La ejecución se canceló antes de terminar."}},"fr":{"stringUnit":{"state":"translated","value":"L’exécution a été annulée avant la fin."}},"it":{"stringUnit":{"state":"needs_review","value":"L'esecuzione è stata annullata prima di terminare."}},"ja":{"stringUnit":{"state":"translated","value":"実行は完了する前にキャンセルされました。"}},"ko":{"stringUnit":{"state":"needs_review","value":"실행이 끝나기 전에 취소되었습니다."}},"pt":{"stringUnit":{"state":"translated","value":"A execução foi cancelada antes de terminar."}},"ru":{"stringUnit":{"state":"translated","value":"Запуск отменён до завершения."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"运行在完成前被取消。"}}}},
    "The source-language transcript is not loaded beside a translation. It is unchanged on disk." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Transkript in der Ausgangssprache wird neben einer Übersetzung nicht geladen. Auf der Festplatte ist es unverändert."}},"en":{"stringUnit":{"state":"needs_review","value":"The source-language transcript is not loaded beside a translation. It is unchanged on disk."}},"es":{"stringUnit":{"state":"translated","value":"La transcripción en el idioma original no se carga junto a una traducción. En el disco permanece intacta."}},"fr":{"stringUnit":{"state":"translated","value":"La transcription en langue source n'est pas chargée à côté d'une traduction. Sur le disque, elle reste intacte."}},"it":{"stringUnit":{"state":"needs_review","value":"La trascrizione nella lingua di origine non viene caricata accanto a una traduzione. Su disco resta invariata."}},"ja":{"stringUnit":{"state":"translated","value":"翻訳と並べて原語の文字起こしは読み込まれません。ディスク上のファイルは変更されていません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"번역본과 함께 원문 전사문은 불러오지 않습니다. 디스크의 파일은 그대로입니다."}},"pt":{"stringUnit":{"state":"translated","value":"A transcrição no idioma de origem não é carregada junto de uma tradução. No disco permanece inalterada."}},"ru":{"stringUnit":{"state":"translated","value":"Расшифровка на исходном языке не загружается рядом с переводом. На диске она не изменилась."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"源语言转录文本不会与译文一同加载。磁盘上的文件保持不变。"}}}},
    "The speaker separation model this profile needs is not installed on this Mac." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprechertrennungsmodell, das dieses Profil benötigt, ist auf diesem Mac nicht installiert."}},"en":{"stringUnit":{"state":"needs_review","value":"The speaker separation model this profile needs is not installed on this Mac."}},"es":{"stringUnit":{"state":"translated","value":"El modelo de separación de hablantes que necesita este perfil no está instalado en esta Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle de séparation des locuteurs requis par ce profil n'est pas installé sur ce Mac."}},"it":{"stringUnit":{"state":"needs_review","value":"Il modello di separazione dei parlanti richiesto da questo profilo non è installato su questo Mac."}},"ja":{"stringUnit":{"state":"translated","value":"このプロファイルに必要な話者分離モデルがこの Mac にインストールされていません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 프로필에 필요한 화자 분리 모델이 이 Mac에 설치되어 있지 않습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O modelo de separação de falantes exigido por este perfil não está instalado neste Mac."}},"ru":{"stringUnit":{"state":"translated","value":"Модель разделения говорящих, необходимая этому профилю, не установлена на этом Mac."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此配置文件所需的说话人分离模型尚未安装在这台 Mac 上。"}}}},
    "The speaker timeline covered %@ of this segment, below the %@ it needs." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Sprecherzeitleiste deckte %@ dieses Segments ab, unter den erforderlichen %@."}},"en":{"stringUnit":{"state":"needs_review","value":"The speaker timeline covered %@ of this segment, below the %@ it needs."}},"es":{"stringUnit":{"state":"translated","value":"La línea de tiempo cubrió %@ de este segmento, por debajo del %@ requerido."}},"fr":{"stringUnit":{"state":"translated","value":"La chronologie couvrait %@ de ce segment, sous les %@ requis."}},"it":{"stringUnit":{"state":"needs_review","value":"La timeline copriva %@ di questo segmento, sotto il %@ richiesto."}},"ja":{"stringUnit":{"state":"translated","value":"話者タイムラインはこのセグメントの %@ しか覆っておらず、必要な %@ を下回ります。"}},"ko":{"stringUnit":{"state":"needs_review","value":"화자 타임라인이 이 구간의 %@만 덮어 필요한 %@에 못 미칩니다."}},"pt":{"stringUnit":{"state":"translated","value":"A linha do tempo cobriu %@ deste segmento, abaixo dos %@ necessários."}},"ru":{"stringUnit":{"state":"translated","value":"Шкала говорящих покрыла %@ этого сегмента, ниже требуемых %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"说话人时间轴仅覆盖此片段的 %@，低于所需的 %@。"}}}},
    "The speech model also reported a speaker for this segment. It is kept as evidence and never becomes the speaker." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprachmodell hat für dieses Segment ebenfalls einen Sprecher gemeldet. Er wird als Nachweis aufbewahrt und wird nie zum Sprecher."}},"en":{"stringUnit":{"state":"needs_review","value":"The speech model also reported a speaker for this segment. It is kept as evidence and never becomes the speaker."}},"es":{"stringUnit":{"state":"translated","value":"El modelo de voz también informó de un hablante para este segmento. Se conserva como evidencia y nunca se convierte en el hablante."}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle de parole a lui aussi signalé un locuteur pour ce segment. Il est conservé comme preuve et ne devient jamais le locuteur."}},"it":{"stringUnit":{"state":"needs_review","value":"Anche il modello vocale ha indicato un parlante per questo segmento. Viene conservato come prova e non diventa mai il parlante."}},"ja":{"stringUnit":{"state":"translated","value":"音声モデルもこのセグメントの話者を報告しました。これは根拠として保持され、話者になることはありません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"음성 모델도 이 구간의 화자를 보고했습니다. 이 값은 근거로 남고 화자가 되지는 않습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O modelo de voz também indicou um falante para este segmento. É guardado como evidência e nunca se torna o falante."}},"ru":{"stringUnit":{"state":"translated","value":"Речевая модель также сообщила говорящего для этого сегмента. Это сохраняется как свидетельство и никогда не становится говорящим."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"语音模型也为此片段报告了一个说话人。该值仅作为证据保留，绝不会成为说话人。"}}}},
    "The speech model that answered is not the exact model this profile pins, so its output was refused." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das antwortende Sprachmodell ist nicht genau das von diesem Profil festgelegte Modell, daher wurde seine Ausgabe abgelehnt."}},"en":{"stringUnit":{"state":"needs_review","value":"The speech model that answered is not the exact model this profile pins, so its output was refused."}},"es":{"stringUnit":{"state":"translated","value":"El modelo de voz que respondió no es exactamente el que fija este perfil, así que se rechazó su salida."}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle vocal qui a répondu n’est pas exactement celui épinglé par ce profil ; sa sortie a été refusée."}},"it":{"stringUnit":{"state":"needs_review","value":"Il modello vocale che ha risposto non è esattamente quello fissato da questo profilo, quindi il suo output è stato rifiutato."}},"ja":{"stringUnit":{"state":"translated","value":"応答した音声モデルがこのプロフィールの固定モデルと一致しないため、その出力は拒否されました。"}},"ko":{"stringUnit":{"state":"needs_review","value":"응답한 음성 모델이 이 프로필이 고정한 모델과 정확히 일치하지 않아 그 출력을 받아들이지 않았습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O modelo de fala que respondeu não é exatamente o modelo fixado por este perfil, por isso a saída foi recusada."}},"ru":{"stringUnit":{"state":"translated","value":"Ответившая речевая модель не совпадает с моделью, закреплённой в этом профиле, поэтому её вывод отклонён."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"作出响应的语音模型并非此配置文件锁定的模型，其输出已被拒绝。"}}}},
    "The speech recognition model this profile needs is not installed on this Mac." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Spracherkennungsmodell, das dieses Profil benötigt, ist auf diesem Mac nicht installiert."}},"en":{"stringUnit":{"state":"needs_review","value":"The speech recognition model this profile needs is not installed on this Mac."}},"es":{"stringUnit":{"state":"translated","value":"El modelo de reconocimiento de voz que necesita este perfil no está instalado en esta Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle de reconnaissance vocale requis par ce profil n'est pas installé sur ce Mac."}},"it":{"stringUnit":{"state":"needs_review","value":"Il modello di riconoscimento vocale richiesto da questo profilo non è installato su questo Mac."}},"ja":{"stringUnit":{"state":"translated","value":"このプロファイルに必要な音声認識モデルがこの Mac にインストールされていません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 프로필에 필요한 음성 인식 모델이 이 Mac에 설치되어 있지 않습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O modelo de reconhecimento de fala exigido por este perfil não está instalado neste Mac."}},"ru":{"stringUnit":{"state":"translated","value":"Модель распознавания речи, необходимая этому профилю, не установлена на этом Mac."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此配置文件所需的语音识别模型尚未安装在这台 Mac 上。"}}}},
    "The voice activity model this profile needs is not installed on this Mac." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Sprachaktivitätsmodell, das dieses Profil benötigt, ist auf diesem Mac nicht installiert."}},"en":{"stringUnit":{"state":"needs_review","value":"The voice activity model this profile needs is not installed on this Mac."}},"es":{"stringUnit":{"state":"translated","value":"El modelo de detección de actividad de voz que necesita este perfil no está instalado en esta Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Le modèle de détection d'activité vocale requis par ce profil n'est pas installé sur ce Mac."}},"it":{"stringUnit":{"state":"needs_review","value":"Il modello di rilevamento del parlato richiesto da questo profilo non è installato su questo Mac."}},"ja":{"stringUnit":{"state":"translated","value":"このプロファイルに必要な音声区間検出モデルがこの Mac にインストールされていません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 프로필에 필요한 음성 구간 감지 모델이 이 Mac에 설치되어 있지 않습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O modelo de detecção de atividade de voz exigido por este perfil não está instalado neste Mac."}},"ru":{"stringUnit":{"state":"translated","value":"Модель определения речевой активности, необходимая этому профилю, не установлена на этом Mac."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此配置文件所需的语音活动检测模型尚未安装在这台 Mac 上。"}}}},
    "This Run" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Lauf"}},"en":{"stringUnit":{"state":"needs_review","value":"This Run"}},"es":{"stringUnit":{"state":"translated","value":"Esta ejecución"}},"fr":{"stringUnit":{"state":"translated","value":"Cette exécution"}},"it":{"stringUnit":{"state":"needs_review","value":"Questa esecuzione"}},"ja":{"stringUnit":{"state":"translated","value":"この実行"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 실행"}},"pt":{"stringUnit":{"state":"translated","value":"Esta execução"}},"ru":{"stringUnit":{"state":"translated","value":"Этот запуск"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本次运行"}}}},
    "This profile could not run with the settings it was given." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieses Profil konnte mit den übergebenen Einstellungen nicht laufen."}},"en":{"stringUnit":{"state":"needs_review","value":"This profile could not run with the settings it was given."}},"es":{"stringUnit":{"state":"translated","value":"Este perfil no pudo ejecutarse con los ajustes recibidos."}},"fr":{"stringUnit":{"state":"translated","value":"Ce profil n’a pas pu s’exécuter avec les réglages fournis."}},"it":{"stringUnit":{"state":"needs_review","value":"Questo profilo non è stato eseguibile con le impostazioni ricevute."}},"ja":{"stringUnit":{"state":"translated","value":"このプロフィールは与えられた設定では実行できませんでした。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 프로필은 주어진 설정으로 실행할 수 없었습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Este perfil não pôde ser executado com as configurações recebidas."}},"ru":{"stringUnit":{"state":"translated","value":"Этот профиль не смог запуститься с заданными настройками."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此配置文件无法在给定的设置下运行。"}}}},
    "This profile is not ready to run." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieses Profil ist nicht bereit für einen Durchlauf."}},"en":{"stringUnit":{"state":"needs_review","value":"This profile is not ready to run."}},"es":{"stringUnit":{"state":"translated","value":"Este perfil no está listo para ejecutarse."}},"fr":{"stringUnit":{"state":"translated","value":"Ce profil n'est pas prêt à être exécuté."}},"it":{"stringUnit":{"state":"needs_review","value":"Questo profilo non è pronto per l'esecuzione."}},"ja":{"stringUnit":{"state":"translated","value":"このプロファイルは実行できる状態ではありません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 프로필은 실행할 준비가 되지 않았습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Este perfil não está pronto para ser executado."}},"ru":{"stringUnit":{"state":"translated","value":"Этот профиль не готов к запуску."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此配置文件尚未准备好运行。"}}}},
    "This run has not produced this layer." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieser Lauf hat diese Ebene nicht erzeugt."}},"en":{"stringUnit":{"state":"needs_review","value":"This run has not produced this layer."}},"es":{"stringUnit":{"state":"translated","value":"Esta ejecución no ha producido esta capa."}},"fr":{"stringUnit":{"state":"translated","value":"Cette exécution n'a pas produit cette couche."}},"it":{"stringUnit":{"state":"needs_review","value":"Questa esecuzione non ha prodotto questo livello."}},"ja":{"stringUnit":{"state":"translated","value":"この実行はこのレイヤーを作成していません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 실행은 이 레이어를 만들지 않았습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Esta execução não produziu esta camada."}},"ru":{"stringUnit":{"state":"translated","value":"Этот запуск не создал такой слой."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本次运行未生成该图层。"}}}},
    "This segment carries no recorded speaker evidence." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Für dieses Segment ist kein Sprechernachweis aufgezeichnet."}},"en":{"stringUnit":{"state":"needs_review","value":"This segment carries no recorded speaker evidence."}},"es":{"stringUnit":{"state":"translated","value":"Este segmento no tiene evidencia de hablante registrada."}},"fr":{"stringUnit":{"state":"translated","value":"Ce segment ne comporte aucune preuve de locuteur enregistrée."}},"it":{"stringUnit":{"state":"needs_review","value":"Questo segmento non riporta prove sul parlante."}},"ja":{"stringUnit":{"state":"translated","value":"このセグメントには話者の記録された根拠がありません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 구간에는 기록된 화자 근거가 없습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Este segmento não tem evidência de falante registada."}},"ru":{"stringUnit":{"state":"translated","value":"Для этого сегмента не записаны данные о говорящем."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此片段没有记录任何说话人证据。"}}}},
    "This speaker held this much of the segment's speech." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"So viel der Sprache dieses Segments entfiel auf diesen Sprecher."}},"en":{"stringUnit":{"state":"needs_review","value":"This speaker held this much of the segment's speech."}},"es":{"stringUnit":{"state":"translated","value":"Esta es la parte del habla del segmento que corresponde a este hablante."}},"fr":{"stringUnit":{"state":"translated","value":"Part de la parole du segment revenant à ce locuteur."}},"it":{"stringUnit":{"state":"needs_review","value":"Questa è la quota di parlato del segmento attribuita a questo parlante."}},"ja":{"stringUnit":{"state":"translated","value":"このセグメントの発話のうち、この話者が占める割合です。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 구간 발화에서 이 화자가 차지한 비율입니다."}},"pt":{"stringUnit":{"state":"translated","value":"Esta é a parte da fala do segmento atribuída a este falante."}},"ru":{"stringUnit":{"state":"translated","value":"Доля речи сегмента, приходящаяся на этого говорящего."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"该说话人在此片段语音中所占的比例。"}}}},
    "This stage covered only part of the recording." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Phase hat nur einen Teil der Aufnahme abgedeckt."}},"en":{"stringUnit":{"state":"needs_review","value":"This stage covered only part of the recording."}},"es":{"stringUnit":{"state":"translated","value":"Esta fase solo cubrió una parte de la grabación."}},"fr":{"stringUnit":{"state":"translated","value":"Cette étape n’a couvert qu’une partie de l’enregistrement."}},"it":{"stringUnit":{"state":"needs_review","value":"Questa fase ha coperto solo una parte della registrazione."}},"ja":{"stringUnit":{"state":"translated","value":"この段階は録音の一部しか処理していません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 단계는 녹음의 일부만 처리했습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Esta etapa cobriu apenas parte da gravação."}},"ru":{"stringUnit":{"state":"translated","value":"Этот этап охватил только часть записи."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此阶段只覆盖了录音的一部分。"}}}},
    "This stage stopped the run." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Diese Phase hat den Lauf angehalten."}},"en":{"stringUnit":{"state":"needs_review","value":"This stage stopped the run."}},"es":{"stringUnit":{"state":"translated","value":"Esta fase detuvo la ejecución."}},"fr":{"stringUnit":{"state":"translated","value":"Cette étape a interrompu l’exécution."}},"it":{"stringUnit":{"state":"needs_review","value":"Questa fase ha interrotto l'esecuzione."}},"ja":{"stringUnit":{"state":"translated","value":"この段階で実行が停止しました。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 단계에서 실행이 멈췄습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Esta etapa interrompeu a execução."}},"ru":{"stringUnit":{"state":"translated","value":"На этом этапе запуск остановился."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"运行在此阶段停止。"}}}},
    "Timeline coverage %@, and this run named a speaker only above %@." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zeitleistenabdeckung %@; dieser Lauf benannte einen Sprecher erst ab %@."}},"en":{"stringUnit":{"state":"needs_review","value":"Timeline coverage %@, and this run named a speaker only above %@."}},"es":{"stringUnit":{"state":"translated","value":"Cobertura de la línea de tiempo %@; esta ejecución solo nombró un hablante por encima de %@."}},"fr":{"stringUnit":{"state":"translated","value":"Couverture de la chronologie %@ ; cette exécution ne nommait un locuteur qu'au-dessus de %@."}},"it":{"stringUnit":{"state":"needs_review","value":"Copertura della timeline %@; questa esecuzione indicava un parlante solo sopra %@."}},"ja":{"stringUnit":{"state":"translated","value":"タイムラインの被覆率は %@ で、この実行は %@ を超えた場合にのみ話者を特定しました。"}},"ko":{"stringUnit":{"state":"needs_review","value":"타임라인 커버리지는 %@이고, 이 실행은 %@를 넘을 때만 화자를 정했습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Cobertura da linha do tempo %@; esta execução só indicou um falante acima de %@."}},"ru":{"stringUnit":{"state":"translated","value":"Покрытие шкалы %@; этот запуск называл говорящего только выше %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"时间轴覆盖率为 %@，本次运行仅在高于 %@ 时才确定说话人。"}}}},

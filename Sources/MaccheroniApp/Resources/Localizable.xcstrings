    "Copy Selection" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Auswahl kopieren"}},"en":{"stringUnit":{"state":"needs_review","value":"Copy Selection"}},"es":{"stringUnit":{"state":"translated","value":"Copiar la selección"}},"fr":{"stringUnit":{"state":"translated","value":"Copier la sélection"}},"it":{"stringUnit":{"state":"needs_review","value":"Copia la selezione"}},"ja":{"stringUnit":{"state":"translated","value":"選択範囲をコピー"}},"ko":{"stringUnit":{"state":"needs_review","value":"선택 항목 복사"}},"pt":{"stringUnit":{"state":"translated","value":"Copiar seleção"}},"ru":{"stringUnit":{"state":"translated","value":"Копировать выбранное"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"复制所选内容"}}}},
    "The transcript could not be copied." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Transkript konnte nicht kopiert werden."}},"en":{"stringUnit":{"state":"needs_review","value":"The transcript could not be copied."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo copiar la transcripción."}},"fr":{"stringUnit":{"state":"translated","value":"Impossible de copier la transcription."}},"it":{"stringUnit":{"state":"needs_review","value":"Impossibile copiare la trascrizione."}},"ja":{"stringUnit":{"state":"translated","value":"文字起こしをコピーできませんでした。"}},"ko":{"stringUnit":{"state":"needs_review","value":"전사문을 복사할 수 없습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Não foi possível copiar a transcrição."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось скопировать расшифровку."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法复制转录文本。"}}}},
    "Select this segment for copying." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieses Segment zum Kopieren auswählen."}},"en":{"stringUnit":{"state":"needs_review","value":"Select this segment for copying."}},"es":{"stringUnit":{"state":"translated","value":"Selecciona este segmento para copiarlo."}},"fr":{"stringUnit":{"state":"translated","value":"Sélectionner ce segment pour le copier."}},"it":{"stringUnit":{"state":"needs_review","value":"Seleziona questo segmento per copiarlo."}},"ja":{"stringUnit":{"state":"translated","value":"コピー対象にこのセグメントを追加します。"}},"ko":{"stringUnit":{"state":"needs_review","value":"복사할 세그먼트로 선택합니다."}},"pt":{"stringUnit":{"state":"translated","value":"Selecione este segmento para copiá-lo."}},"ru":{"stringUnit":{"state":"translated","value":"Выбрать этот сегмент для копирования."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择此片段以复制。"}}}},
    "Remove this segment from the copy selection." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Dieses Segment aus der Kopierauswahl entfernen."}},"en":{"stringUnit":{"state":"needs_review","value":"Remove this segment from the copy selection."}},"es":{"stringUnit":{"state":"translated","value":"Quita este segmento de la selección para copiar."}},"fr":{"stringUnit":{"state":"translated","value":"Retirer ce segment de la sélection à copier."}},"it":{"stringUnit":{"state":"needs_review","value":"Rimuovi questo segmento dalla selezione da copiare."}},"ja":{"stringUnit":{"state":"translated","value":"このセグメントをコピー対象から外します。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 세그먼트를 복사 선택 항목에서 제거합니다."}},"pt":{"stringUnit":{"state":"translated","value":"Remova este segmento da seleção para cópia."}},"ru":{"stringUnit":{"state":"translated","value":"Удалить этот сегмент из выбранного для копирования."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从复制所选内容中移除此片段。"}}}},
    "Copied the speaker-labelled transcript." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Das Transkript mit Sprecherzuordnung wurde kopiert."}},"en":{"stringUnit":{"state":"needs_review","value":"Copied the speaker-labelled transcript."}},"es":{"stringUnit":{"state":"translated","value":"Se copió la transcripción con hablantes etiquetados."}},"fr":{"stringUnit":{"state":"translated","value":"La transcription avec locuteurs identifiés a été copiée."}},"it":{"stringUnit":{"state":"needs_review","value":"La trascrizione con parlanti etichettati è stata copiata."}},"ja":{"stringUnit":{"state":"translated","value":"話者ラベル付き文字起こしをコピーしました。"}},"ko":{"stringUnit":{"state":"needs_review","value":"화자 레이블이 포함된 전사문을 복사했습니다."}},"pt":{"stringUnit":{"state":"translated","value":"A transcrição com falantes identificados foi copiada."}},"ru":{"stringUnit":{"state":"translated","value":"Расшифровка с обозначением говорящих скопирована."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已复制标注说话人的转录文本。"}}}},

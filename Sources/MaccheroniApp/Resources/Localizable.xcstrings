    "Installed, but sign-in status could not be checked." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Installiert, aber der Anmeldestatus konnte nicht überprüft werden."}},"en":{"stringUnit":{"state":"needs_review","value":"Installed, but sign-in status could not be checked."}},"es":{"stringUnit":{"state":"translated","value":"Instalado, pero no se pudo comprobar el estado de inicio de sesión."}},"fr":{"stringUnit":{"state":"translated","value":"Installé, mais l’état de connexion n’a pas pu être vérifié."}},"it":{"stringUnit":{"state":"needs_review","value":"Installato, ma non è stato possibile verificare lo stato di accesso."}},"ja":{"stringUnit":{"state":"translated","value":"インストール済みですが、サインイン状態を確認できませんでした。"}},"ko":{"stringUnit":{"state":"needs_review","value":"설치되어 있지만 로그인 상태를 확인하지 못했습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Instalado, mas não foi possível verificar o estado de início de sessão."}},"ru":{"stringUnit":{"state":"translated","value":"Установлен, но не удалось проверить состояние входа."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已安装，但无法检查登录状态。"}}}},
    "Installed, not signed in. Run codex login in Terminal." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Installiert, nicht angemeldet. Führen Sie codex login im Terminal aus."}},"en":{"stringUnit":{"state":"needs_review","value":"Installed, not signed in. Run codex login in Terminal."}},"es":{"stringUnit":{"state":"translated","value":"Instalado, sin sesión iniciada. Ejecuta codex login en Terminal."}},"fr":{"stringUnit":{"state":"translated","value":"Installé, non connecté. Exécutez codex login dans Terminal."}},"it":{"stringUnit":{"state":"needs_review","value":"Installato, senza accesso. Esegui codex login in Terminale."}},"ja":{"stringUnit":{"state":"translated","value":"インストール済み、未サインインです。ターミナルで codex login を実行してください。"}},"ko":{"stringUnit":{"state":"needs_review","value":"설치되었지만 로그인하지 않았습니다. 터미널에서 codex login을 실행하세요."}},"pt":{"stringUnit":{"state":"translated","value":"Instalado, não autenticado. Execute codex login no Terminal."}},"ru":{"stringUnit":{"state":"translated","value":"Установлен, вход не выполнен. Выполните codex login в Терминале."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已安装但尚未登录。请在终端中运行 codex login。"}}}},

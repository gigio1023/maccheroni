    "Glossary Used" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verwendetes Glossar"}},"en":{"stringUnit":{"state":"needs_review","value":"Glossary Used"}},"es":{"stringUnit":{"state":"translated","value":"Glosario utilizado"}},"fr":{"stringUnit":{"state":"translated","value":"Glossaire utilisé"}},"it":{"stringUnit":{"state":"needs_review","value":"Glossario usato"}},"ja":{"stringUnit":{"state":"translated","value":"使用した用語集"}},"ko":{"stringUnit":{"state":"needs_review","value":"사용한 용어집"}},"pt":{"stringUnit":{"state":"translated","value":"Glossário utilizado"}},"ru":{"stringUnit":{"state":"translated","value":"Использованный глоссарий"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"使用的术语表"}}}},
    "Go to the next segment to review" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zum nächsten zu prüfenden Segment"}},"en":{"stringUnit":{"state":"needs_review","value":"Go to the next segment to review"}},"es":{"stringUnit":{"state":"translated","value":"Ir al siguiente segmento por revisar"}},"fr":{"stringUnit":{"state":"translated","value":"Aller au segment suivant à vérifier"}},"it":{"stringUnit":{"state":"needs_review","value":"Vai al segmento successivo da rivedere"}},"ja":{"stringUnit":{"state":"translated","value":"次の要確認セグメントへ移動"}},"ko":{"stringUnit":{"state":"needs_review","value":"다음 확인 필요 구간으로 이동"}},"pt":{"stringUnit":{"state":"translated","value":"Ir para o segmento seguinte por rever"}},"ru":{"stringUnit":{"state":"translated","value":"К следующему сегменту на проверку"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转到下一个待复核片段"}}}},
    "Go to the previous segment to review" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zum vorherigen zu prüfenden Segment"}},"en":{"stringUnit":{"state":"needs_review","value":"Go to the previous segment to review"}},"es":{"stringUnit":{"state":"translated","value":"Ir al segmento anterior por revisar"}},"fr":{"stringUnit":{"state":"translated","value":"Aller au segment précédent à vérifier"}},"it":{"stringUnit":{"state":"needs_review","value":"Vai al segmento precedente da rivedere"}},"ja":{"stringUnit":{"state":"translated","value":"前の要確認セグメントへ移動"}},"ko":{"stringUnit":{"state":"needs_review","value":"이전 확인 필요 구간으로 이동"}},"pt":{"stringUnit":{"state":"translated","value":"Ir para o segmento anterior por rever"}},"ru":{"stringUnit":{"state":"translated","value":"К предыдущему сегменту на проверку"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转到上一个待复核片段"}}}},
    "How" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wie"}},"en":{"stringUnit":{"state":"needs_review","value":"How"}},"es":{"stringUnit":{"state":"translated","value":"Cómo"}},"fr":{"stringUnit":{"state":"translated","value":"Comment"}},"it":{"stringUnit":{"state":"needs_review","value":"Come"}},"ja":{"stringUnit":{"state":"translated","value":"方法"}},"ko":{"stringUnit":{"state":"needs_review","value":"방식"}},"pt":{"stringUnit":{"state":"translated","value":"Como"}},"ru":{"stringUnit":{"state":"translated","value":"Как"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"方式"}}}},
    "In the model's context prompt" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Im Kontext-Prompt des Modells"}},"en":{"stringUnit":{"state":"needs_review","value":"In the model's context prompt"}},"es":{"stringUnit":{"state":"translated","value":"En el prompt de contexto del modelo"}},"fr":{"stringUnit":{"state":"translated","value":"Dans l'invite de contexte du modèle"}},"it":{"stringUnit":{"state":"needs_review","value":"Nel prompt di contesto del modello"}},"ja":{"stringUnit":{"state":"translated","value":"モデルのコンテキストプロンプト内"}},"ko":{"stringUnit":{"state":"needs_review","value":"모델의 컨텍스트 프롬프트에"}},"pt":{"stringUnit":{"state":"translated","value":"No prompt de contexto do modelo"}},"ru":{"stringUnit":{"state":"translated","value":"В контекстном запросе модели"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在模型的上下文提示中"}}}},
    "Install the missing components by running this in Terminal from the Maccheroni repository, then check again:" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Installieren Sie die fehlenden Komponenten, indem Sie dies im Terminal im Maccheroni-Repository ausführen, und prüfen Sie dann erneut:"}},"en":{"stringUnit":{"state":"needs_review","value":"Install the missing components by running this in Terminal from the Maccheroni repository, then check again:"}},"es":{"stringUnit":{"state":"translated","value":"Instala los componentes que faltan ejecutando esto en Terminal desde el repositorio de Maccheroni y vuelve a comprobar:"}},"fr":{"stringUnit":{"state":"translated","value":"Installez les composants manquants en exécutant ceci dans le Terminal depuis le dépôt Maccheroni, puis vérifiez à nouveau :"}},"it":{"stringUnit":{"state":"needs_review","value":"Installa i componenti mancanti eseguendo questo comando nel Terminale dalla cartella del repository Maccheroni, poi controlla di nuovo:"}},"ja":{"stringUnit":{"state":"translated","value":"Maccheroni リポジトリでターミナルから次のコマンドを実行して不足しているコンポーネントをインストールし、もう一度確認してください:"}},"ko":{"stringUnit":{"state":"needs_review","value":"Maccheroni 저장소에서 터미널로 아래 명령을 실행해 빠진 구성 요소를 설치한 뒤 다시 확인하세요:"}},"pt":{"stringUnit":{"state":"translated","value":"Instale os componentes ausentes executando isto no Terminal a partir do repositório do Maccheroni e verifique novamente:"}},"ru":{"stringUnit":{"state":"translated","value":"Установите недостающие компоненты, выполнив эту команду в Терминале в репозитории Maccheroni, затем проверьте снова:"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在 Maccheroni 仓库目录下于“终端”运行以下命令安装缺失的组件，然后再次检查："}}}},
    "Maccheroni cannot use the microphone. Turn Maccheroni on in System Settings > Privacy & Security > Microphone." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Maccheroni kann das Mikrofon nicht verwenden. Aktivieren Sie Maccheroni unter Systemeinstellungen > Datenschutz & Sicherheit > Mikrofon."}},"en":{"stringUnit":{"state":"needs_review","value":"Maccheroni cannot use the microphone. Turn Maccheroni on in System Settings > Privacy & Security > Microphone."}},"es":{"stringUnit":{"state":"translated","value":"Maccheroni no puede usar el micrófono. Activa Maccheroni en Ajustes del Sistema > Privacidad y seguridad > Micrófono."}},"fr":{"stringUnit":{"state":"translated","value":"Maccheroni ne peut pas utiliser le microphone. Activez Maccheroni dans Réglages Système > Confidentialité et sécurité > Microphone."}},"it":{"stringUnit":{"state":"needs_review","value":"Maccheroni non può usare il microfono. Attiva Maccheroni in Impostazioni di Sistema > Privacy e sicurezza > Microfono."}},"ja":{"stringUnit":{"state":"translated","value":"Maccheroni がマイクを使用できません。システム設定 > プライバシーとセキュリティ > マイク で Maccheroni をオンにしてください。"}},"ko":{"stringUnit":{"state":"needs_review","value":"Maccheroni가 마이크를 사용할 수 없습니다. 시스템 설정 > 개인정보 보호 및 보안 > 마이크에서 Maccheroni를 켜세요."}},"pt":{"stringUnit":{"state":"translated","value":"O Maccheroni não pode usar o microfone. Ative o Maccheroni em Ajustes do Sistema > Privacidade e Segurança > Microfone."}},"ru":{"stringUnit":{"state":"translated","value":"Maccheroni не может использовать микрофон. Включите Maccheroni в разделе «Системные настройки > Конфиденциальность и безопасность > Микрофон»."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Maccheroni 无法使用麦克风。请在“系统设置 > 隐私与安全性 > 麦克风”中打开 Maccheroni。"}}}},
    "Maccheroni could not check whether this profile is ready: %@" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Maccheroni konnte nicht prüfen, ob dieses Profil bereit ist: %@"}},"en":{"stringUnit":{"state":"needs_review","value":"Maccheroni could not check whether this profile is ready: %@"}},"es":{"stringUnit":{"state":"translated","value":"Maccheroni no pudo comprobar si este perfil está listo: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Maccheroni n'a pas pu vérifier si ce profil est prêt : %@"}},"it":{"stringUnit":{"state":"needs_review","value":"Maccheroni non è riuscito a verificare se questo profilo è pronto: %@"}},"ja":{"stringUnit":{"state":"translated","value":"Maccheroni はこのプロファイルが準備できているか確認できませんでした: %@"}},"ko":{"stringUnit":{"state":"needs_review","value":"Maccheroni가 이 프로필의 준비 상태를 확인하지 못했습니다: %@"}},"pt":{"stringUnit":{"state":"translated","value":"O Maccheroni não conseguiu verificar se este perfil está pronto: %@"}},"ru":{"stringUnit":{"state":"translated","value":"Maccheroni не удалось проверить готовность этого профиля: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Maccheroni 无法检查此配置文件是否就绪：%@"}}}},
    "Maccheroni could not join the transcript with the speaker timeline." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Maccheroni konnte das Transkript nicht mit der Sprecher-Zeitleiste zusammenführen."}},"en":{"stringUnit":{"state":"needs_review","value":"Maccheroni could not join the transcript with the speaker timeline."}},"es":{"stringUnit":{"state":"translated","value":"Maccheroni no pudo unir la transcripción con la línea de tiempo de hablantes."}},"fr":{"stringUnit":{"state":"translated","value":"Maccheroni n’a pas pu associer la transcription à la chronologie des locuteurs."}},"it":{"stringUnit":{"state":"needs_review","value":"Maccheroni non è riuscito a unire la trascrizione con la timeline dei parlanti."}},"ja":{"stringUnit":{"state":"translated","value":"Maccheroni は文字起こしと話者タイムラインを結合できませんでした。"}},"ko":{"stringUnit":{"state":"needs_review","value":"Maccheroni가 전사문과 화자 타임라인을 합치지 못했습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O Maccheroni não conseguiu unir a transcrição com a linha do tempo de falantes."}},"ru":{"stringUnit":{"state":"translated","value":"Maccheroni не смог объединить расшифровку с таймлайном говорящих."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Maccheroni 无法将转录文本与说话人时间轴合并。"}}}},
    "Maccheroni could not prepare this audio for transcription." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Maccheroni konnte dieses Audio nicht für die Transkription vorbereiten."}},"en":{"stringUnit":{"state":"needs_review","value":"Maccheroni could not prepare this audio for transcription."}},"es":{"stringUnit":{"state":"translated","value":"Maccheroni no pudo preparar este audio para la transcripción."}},"fr":{"stringUnit":{"state":"translated","value":"Maccheroni n’a pas pu préparer cet audio pour la transcription."}},"it":{"stringUnit":{"state":"needs_review","value":"Maccheroni non è riuscito a preparare questo audio per la trascrizione."}},"ja":{"stringUnit":{"state":"translated","value":"Maccheroni はこのオーディオを転写用に準備できませんでした。"}},"ko":{"stringUnit":{"state":"needs_review","value":"Maccheroni가 이 오디오를 전사용으로 준비하지 못했습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O Maccheroni não conseguiu preparar este áudio para a transcrição."}},"ru":{"stringUnit":{"state":"translated","value":"Maccheroni не смог подготовить это аудио к транскрипции."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Maccheroni 无法为转录准备这段音频。"}}}},
    "Maccheroni could not read the readiness report from its command-line engine." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Maccheroni konnte den Bereitschaftsbericht seiner Befehlszeilen-Engine nicht lesen."}},"en":{"stringUnit":{"state":"needs_review","value":"Maccheroni could not read the readiness report from its command-line engine."}},"es":{"stringUnit":{"state":"translated","value":"Maccheroni no pudo leer el informe de preparación de su motor de línea de comandos."}},"fr":{"stringUnit":{"state":"translated","value":"Maccheroni n'a pas pu lire le rapport de disponibilité de son moteur de ligne de commande."}},"it":{"stringUnit":{"state":"needs_review","value":"Maccheroni non è riuscito a leggere il rapporto di prontezza del suo motore a riga di comando."}},"ja":{"stringUnit":{"state":"translated","value":"Maccheroni はコマンドライン エンジンからの準備状況レポートを読み取れませんでした。"}},"ko":{"stringUnit":{"state":"needs_review","value":"Maccheroni가 명령줄 엔진이 보낸 준비 상태 보고서를 읽지 못했습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O Maccheroni não conseguiu ler o relatório de prontidão do seu mecanismo de linha de comando."}},"ru":{"stringUnit":{"state":"translated","value":"Maccheroni не удалось прочитать отчёт о готовности от механизма командной строки."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Maccheroni 无法读取其命令行引擎返回的就绪报告。"}}}},
    "Maccheroni stopped this run and its record does not name a more specific cause." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Maccheroni hat diesen Lauf angehalten; die Aufzeichnung nennt keine genauere Ursache."}},"en":{"stringUnit":{"state":"needs_review","value":"Maccheroni stopped this run and its record does not name a more specific cause."}},"es":{"stringUnit":{"state":"translated","value":"Maccheroni detuvo esta ejecución y su registro no indica una causa más concreta."}},"fr":{"stringUnit":{"state":"translated","value":"Maccheroni a interrompu cette exécution et son enregistrement n’indique pas de cause plus précise."}},"it":{"stringUnit":{"state":"needs_review","value":"Maccheroni ha interrotto questa esecuzione e il suo registro non indica una causa più specifica."}},"ja":{"stringUnit":{"state":"translated","value":"Maccheroni はこの実行を停止しましたが、記録にはこれ以上具体的な原因が残っていません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"Maccheroni가 이 실행을 멈췄고 기록에는 더 구체적인 원인이 남아 있지 않습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O Maccheroni interrompeu esta execução e o registro não indica uma causa mais específica."}},"ru":{"stringUnit":{"state":"translated","value":"Maccheroni остановил этот запуск, и в записи нет более конкретной причины."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Maccheroni 停止了本次运行，其记录未指出更具体的原因。"}}}},
    "Maccheroni will not assign a speaker without acoustic evidence, so this stays as it is." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Maccheroni weist ohne akustischen Nachweis keinen Sprecher zu, daher bleibt dies unverändert."}},"en":{"stringUnit":{"state":"needs_review","value":"Maccheroni will not assign a speaker without acoustic evidence, so this stays as it is."}},"es":{"stringUnit":{"state":"translated","value":"Maccheroni no asigna un hablante sin evidencia acústica, así que esto queda como está."}},"fr":{"stringUnit":{"state":"translated","value":"Maccheroni n'attribue pas de locuteur sans preuve acoustique ; cela reste donc en l'état."}},"it":{"stringUnit":{"state":"needs_review","value":"Maccheroni non assegna un parlante senza prove acustiche, quindi questo resta com'è."}},"ja":{"stringUnit":{"state":"translated","value":"Maccheroni は音響的な根拠なしに話者を割り当てないため、ここはこのままになります。"}},"ko":{"stringUnit":{"state":"needs_review","value":"Maccheroni는 음향 근거 없이 화자를 배정하지 않으므로 이 구간은 그대로 둡니다."}},"pt":{"stringUnit":{"state":"translated","value":"O Maccheroni não atribui um falante sem evidência acústica, por isso isto fica como está."}},"ru":{"stringUnit":{"state":"translated","value":"Maccheroni не назначает говорящего без акустических данных, поэтому здесь ничего не меняется."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有声学证据时 Maccheroni 不会指派说话人，因此这里保持原样。"}}}},
    "Mark Reviewed" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Als geprüft markieren"}},"en":{"stringUnit":{"state":"needs_review","value":"Mark Reviewed"}},"es":{"stringUnit":{"state":"translated","value":"Marcar como revisado"}},"fr":{"stringUnit":{"state":"translated","value":"Marquer comme vérifié"}},"it":{"stringUnit":{"state":"needs_review","value":"Segna come rivisto"}},"ja":{"stringUnit":{"state":"translated","value":"確認済みにする"}},"ko":{"stringUnit":{"state":"needs_review","value":"확인함으로 표시"}},"pt":{"stringUnit":{"state":"translated","value":"Marcar como revisto"}},"ru":{"stringUnit":{"state":"translated","value":"Отметить проверенным"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"标记为已复核"}}}},
    "Model" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Modell"}},"en":{"stringUnit":{"state":"needs_review","value":"Model"}},"es":{"stringUnit":{"state":"translated","value":"Modelo"}},"fr":{"stringUnit":{"state":"translated","value":"Modèle"}},"it":{"stringUnit":{"state":"needs_review","value":"Modello"}},"ja":{"stringUnit":{"state":"translated","value":"モデル"}},"ko":{"stringUnit":{"state":"needs_review","value":"모델"}},"pt":{"stringUnit":{"state":"translated","value":"Modelo"}},"ru":{"stringUnit":{"state":"translated","value":"Модель"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"模型"}}}},
    "No segment matches this search." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kein Segment entspricht dieser Suche."}},"en":{"stringUnit":{"state":"needs_review","value":"No segment matches this search."}},"es":{"stringUnit":{"state":"translated","value":"Ningún segmento coincide con esta búsqueda."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun segment ne correspond à cette recherche."}},"it":{"stringUnit":{"state":"needs_review","value":"Nessun segmento corrisponde a questa ricerca."}},"ja":{"stringUnit":{"state":"translated","value":"この検索に一致するセグメントはありません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 검색과 일치하는 구간이 없습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Nenhum segmento corresponde a esta pesquisa."}},"ru":{"stringUnit":{"state":"translated","value":"Ни один сегмент не соответствует этому запросу."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有片段与此搜索匹配。"}}}},
    "No speaker held %@ of this segment's speech, so none was named." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kein Sprecher hielt %@ der Sprache dieses Segments, daher wurde keiner benannt."}},"en":{"stringUnit":{"state":"needs_review","value":"No speaker held %@ of this segment's speech, so none was named."}},"es":{"stringUnit":{"state":"translated","value":"Ningún hablante alcanzó %@ del habla de este segmento, así que no se nombró a ninguno."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun locuteur n'a atteint %@ de la parole de ce segment, aucun n'a donc été nommé."}},"it":{"stringUnit":{"state":"needs_review","value":"Nessun parlante ha raggiunto %@ del parlato di questo segmento, quindi nessuno è stato indicato."}},"ja":{"stringUnit":{"state":"translated","value":"このセグメントの発話の %@ に達した話者がいないため、話者は特定されませんでした。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 구간 발화의 %@를 차지한 화자가 없어 화자를 정하지 않았습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Nenhum falante atingiu %@ da fala deste segmento, por isso nenhum foi indicado."}},"ru":{"stringUnit":{"state":"translated","value":"Ни один говорящий не набрал %@ речи этого сегмента, поэтому никто не назван."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有说话人占到此片段语音的 %@，因此未确定说话人。"}}}},
    "No speaker was active on the speaker timeline during this segment." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"In diesem Segment war auf der Sprecherzeitleiste kein Sprecher aktiv."}},"en":{"stringUnit":{"state":"needs_review","value":"No speaker was active on the speaker timeline during this segment."}},"es":{"stringUnit":{"state":"translated","value":"Ningún hablante estaba activo en la línea de tiempo durante este segmento."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun locuteur n'était actif sur la chronologie pendant ce segment."}},"it":{"stringUnit":{"state":"needs_review","value":"Nessun parlante era attivo nella timeline durante questo segmento."}},"ja":{"stringUnit":{"state":"translated","value":"このセグメントの間、話者タイムライン上で話していた話者はいません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 구간 동안 화자 타임라인에서 말한 화자가 없습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Nenhum falante estava ativo na linha do tempo durante este segmento."}},"ru":{"stringUnit":{"state":"translated","value":"В этом сегменте на шкале говорящих никто не был активен."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在此片段期间，说话人时间轴上没有任何说话人。"}}}},
    "Not Transcribed" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Nicht transkribiert"}},"en":{"stringUnit":{"state":"needs_review","value":"Not Transcribed"}},"es":{"stringUnit":{"state":"translated","value":"Sin transcribir"}},"fr":{"stringUnit":{"state":"translated","value":"Non transcrit"}},"it":{"stringUnit":{"state":"needs_review","value":"Non trascritto"}},"ja":{"stringUnit":{"state":"translated","value":"未文字起こし"}},"ko":{"stringUnit":{"state":"needs_review","value":"전사되지 않음"}},"pt":{"stringUnit":{"state":"translated","value":"Não transcrito"}},"ru":{"stringUnit":{"state":"translated","value":"Не расшифровано"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未转录"}}}},

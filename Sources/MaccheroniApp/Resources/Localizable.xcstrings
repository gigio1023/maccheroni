    "The original audio and completed artifacts were preserved. You can inspect the run or try again." : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Der Originalton und die fertigen Artefakte blieben erhalten. Sie können den Lauf überprüfen oder es erneut versuchen."}},"en":{"stringUnit":{"state":"needs_review","value":"The original audio and completed artifacts were preserved. You can inspect the run or try again."}},"es":{"stringUnit":{"state":"translated","value":"Se conservaron el audio original y los artefactos completos. Puede inspeccionar la ejecución o intentarlo nuevamente."}},"fr":{"stringUnit":{"state":"translated","value":"L’audio original et les artefacts terminés ont été préservés. Vous pouvez inspecter l'exécution ou réessayer."}},"it":{"stringUnit":{"state":"needs_review","value":"L'audio originale e gli artefatti completati sono stati conservati. Puoi controllare l'esecuzione o riprovare."}},"ja":{"stringUnit":{"state":"translated","value":"オリジナルのオーディオと完成した成果物は保存されました。実行を検査するか、再試行できます。"}},"ko":{"stringUnit":{"state":"needs_review","value":"원본 오디오와 완료된 산출물을 보존했습니다. 실행을 확인하거나 다시 시도할 수 있습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O áudio original e os artefatos concluídos foram preservados. Você pode inspecionar a execução ou tentar novamente."}},"ru":{"stringUnit":{"state":"translated","value":"Оригинальный звук и завершенные артефакты были сохранены. Вы можете проверить запуск или повторить попытку."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原始音频和完成的工件被保留。您可以检查运行情况或重试。"}}}
    },
    "The original audio and every completed intermediate artifact were preserved." : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Der Originalton und jedes fertige Zwischenartefakt blieben erhalten."}},"en":{"stringUnit":{"state":"needs_review","value":"The original audio and every completed intermediate artifact were preserved."}},"es":{"stringUnit":{"state":"translated","value":"Se conservaron el audio original y todos los artefactos intermedios completos."}},"fr":{"stringUnit":{"state":"translated","value":"L’audio original et chaque artefact intermédiaire terminé ont été préservés."}},"it":{"stringUnit":{"state":"needs_review","value":"L'audio originale e ogni artefatto intermedio completato sono stati preservati."}},"ja":{"stringUnit":{"state":"translated","value":"オリジナルのオーディオと完成したすべての中間成果物が保存されました。"}},"ko":{"stringUnit":{"state":"needs_review","value":"원본 오디오와 완성된 모든 중간 아티팩트가 보존되었습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O áudio original e todos os artefatos intermediários concluídos foram preservados."}},"ru":{"stringUnit":{"state":"translated","value":"Исходный звук и все завершенные промежуточные артефакты были сохранены."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原始音频和每个完成的中间工件都被保留。"}}}
    },
    "The raw run remains on disk, but one or more required artifacts failed an integrity check." : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Der Rohlauf verbleibt auf der Festplatte, aber ein oder mehrere erforderliche Artefakte haben die Integritätsprüfung nicht bestanden."}},"en":{"stringUnit":{"state":"needs_review","value":"The raw run remains on disk, but one or more required artifacts failed an integrity check."}},"es":{"stringUnit":{"state":"translated","value":"La ejecución sin formato permanece en el disco, pero uno o más artefactos requeridos no superaron la verificación de integridad."}},"fr":{"stringUnit":{"state":"translated","value":"L'exécution brute reste sur le disque, mais un ou plusieurs artefacts requis ont échoué à la vérification de l'intégrité."}},"it":{"stringUnit":{"state":"needs_review","value":"L'esecuzione grezza resta sul disco, ma uno o più artefatti richiesti non hanno superato il controllo di integrità."}},"ja":{"stringUnit":{"state":"translated","value":"未処理の実行はディスク上に残りますが、1 つ以上の必要なアーティファクトが整合性チェックに失敗しました。"}},"ko":{"stringUnit":{"state":"needs_review","value":"원시 실행은 디스크에 남아 있지만 필수 산출물 하나 이상이 무결성 검사에 실패했습니다."}},"pt":{"stringUnit":{"state":"translated","value":"A execução bruta permanece no disco, mas um ou mais artefatos necessários falharam na verificação de integridade."}},"ru":{"stringUnit":{"state":"translated","value":"Необработанный прогон остается на диске, но один или несколько необходимых артефактов не прошли проверку целостности."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"原始运行仍保留在磁盘上，但一个或多个所需工件未通过完整性检查。"}}}
    },
    "The recording is preserved and ready for the selected profile." : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Die Aufnahme bleibt erhalten und steht für das ausgewählte Profil bereit."}},"en":{"stringUnit":{"state":"needs_review","value":"The recording is preserved and ready for the selected profile."}},"es":{"stringUnit":{"state":"translated","value":"La grabación se conserva y está lista para el perfil seleccionado."}},"fr":{"stringUnit":{"state":"translated","value":"L'enregistrement est conservé et prêt pour le profil sélectionné."}},"it":{"stringUnit":{"state":"needs_review","value":"La registrazione viene conservata ed è pronta per il profilo selezionato."}},"ja":{"stringUnit":{"state":"translated","value":"録音は保存され、選択したプロファイルで使用できるようになります。"}},"ko":{"stringUnit":{"state":"needs_review","value":"녹음을 보존했으며 선택한 프로필로 전사할 준비가 되었습니다."}},"pt":{"stringUnit":{"state":"translated","value":"A gravação é preservada e pronta para o perfil selecionado."}},"ru":{"stringUnit":{"state":"translated","value":"Запись сохраняется и готова для выбранного профиля."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"录制内容已保存并可供所选配置文件使用。"}}}
    },

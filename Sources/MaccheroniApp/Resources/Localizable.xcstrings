    "Rename…" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Umbenennen…"}},"en":{"stringUnit":{"state":"needs_review","value":"Rename…"}},"es":{"stringUnit":{"state":"translated","value":"Cambiar nombre…"}},"fr":{"stringUnit":{"state":"translated","value":"Renommer…"}},"it":{"stringUnit":{"state":"needs_review","value":"Rinomina…"}},"ja":{"stringUnit":{"state":"translated","value":"名称変更…"}},"ko":{"stringUnit":{"state":"needs_review","value":"이름 변경…"}},"pt":{"stringUnit":{"state":"translated","value":"Mudar nome…"}},"ru":{"stringUnit":{"state":"translated","value":"Переименовать…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"重命名…"}}}},
    "Move to Trash…" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"In den Papierkorb legen…"}},"en":{"stringUnit":{"state":"needs_review","value":"Move to Trash…"}},"es":{"stringUnit":{"state":"translated","value":"Mover a la papelera…"}},"fr":{"stringUnit":{"state":"translated","value":"Déplacer vers la corbeille…"}},"it":{"stringUnit":{"state":"needs_review","value":"Sposta nel cestino…"}},"ja":{"stringUnit":{"state":"translated","value":"ゴミ箱に移動…"}},"ko":{"stringUnit":{"state":"needs_review","value":"휴지통으로 이동…"}},"pt":{"stringUnit":{"state":"translated","value":"Mover para a lixeira…"}},"ru":{"stringUnit":{"state":"translated","value":"Переместить в корзину…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移到垃圾箱…"}}}},
    "Move to Trash" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"In den Papierkorb legen"}},"en":{"stringUnit":{"state":"needs_review","value":"Move to Trash"}},"es":{"stringUnit":{"state":"translated","value":"Mover a la papelera"}},"fr":{"stringUnit":{"state":"translated","value":"Déplacer vers la corbeille"}},"it":{"stringUnit":{"state":"needs_review","value":"Sposta nel cestino"}},"ja":{"stringUnit":{"state":"translated","value":"ゴミ箱に移動"}},"ko":{"stringUnit":{"state":"needs_review","value":"휴지통으로 이동"}},"pt":{"stringUnit":{"state":"translated","value":"Mover para a lixeira"}},"ru":{"stringUnit":{"state":"translated","value":"Переместить в корзину"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"移到垃圾箱"}}}},
    "Remove from Library" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aus der Bibliothek entfernen"}},"en":{"stringUnit":{"state":"needs_review","value":"Remove from Library"}},"es":{"stringUnit":{"state":"translated","value":"Eliminar de la biblioteca"}},"fr":{"stringUnit":{"state":"translated","value":"Retirer de la bibliothèque"}},"it":{"stringUnit":{"state":"needs_review","value":"Rimuovi dall'archivio"}},"ja":{"stringUnit":{"state":"translated","value":"ライブラリから削除"}},"ko":{"stringUnit":{"state":"needs_review","value":"라이브러리에서 제거"}},"pt":{"stringUnit":{"state":"translated","value":"Remover da biblioteca"}},"ru":{"stringUnit":{"state":"translated","value":"Удалить из библиотеки"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从资料库中移除"}}}},
    "Recording Name" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Aufnahmename"}},"en":{"stringUnit":{"state":"needs_review","value":"Recording Name"}},"es":{"stringUnit":{"state":"translated","value":"Nombre de la grabación"}},"fr":{"stringUnit":{"state":"translated","value":"Nom de l’enregistrement"}},"it":{"stringUnit":{"state":"needs_review","value":"Nome della registrazione"}},"ja":{"stringUnit":{"state":"translated","value":"録音の名前"}},"ko":{"stringUnit":{"state":"needs_review","value":"녹음 이름"}},"pt":{"stringUnit":{"state":"translated","value":"Nome da gravação"}},"ru":{"stringUnit":{"state":"translated","value":"Название записи"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"录音名称"}}}},
    "This moves the source audio and the run output to the Trash together. Nothing is deleted, and the Finder's Put Back restores them." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Damit werden die Originalaufnahme und die Run-Ausgabe gemeinsam in den Papierkorb gelegt. Nichts wird gelöscht, und „Zurücklegen“ im Finder stellt sie wieder her."}},"en":{"stringUnit":{"state":"needs_review","value":"This moves the source audio and the run output to the Trash together. Nothing is deleted, and the Finder's Put Back restores them."}},"es":{"stringUnit":{"state":"translated","value":"Esto mueve el audio original y la salida de la ejecución a la papelera a la vez. No se elimina nada, y «Devolver» en el Finder los restaura."}},"fr":{"stringUnit":{"state":"translated","value":"Cela déplace ensemble l’audio source et la sortie de l’exécution vers la corbeille. Rien n’est supprimé, et « Remettre » dans le Finder les restaure."}},"it":{"stringUnit":{"state":"needs_review","value":"Sposta insieme nel cestino l'audio di origine e l'output dell'esecuzione. Non viene eliminato nulla e «Rimetti a posto» nel Finder li ripristina."}},"ja":{"stringUnit":{"state":"translated","value":"元の音声と実行結果をまとめてゴミ箱に移動します。何も削除されず、Finder の「戻す」で元に戻せます。"}},"ko":{"stringUnit":{"state":"needs_review","value":"원본 오디오와 실행 결과를 함께 휴지통으로 옮깁니다. 아무것도 삭제하지 않으며 Finder의 '되돌려놓기'로 복구할 수 있습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Isto move o áudio de origem e a saída da execução para a lixeira em conjunto. Nada é apagado, e «Repor» no Finder restaura-os."}},"ru":{"stringUnit":{"state":"translated","value":"Исходная запись и результат запуска будут перемещены в корзину вместе. Ничего не удаляется, и команда «Положить обратно» в Finder их восстановит."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会将源音频和运行输出一并移到垃圾箱。不会删除任何内容，在 Finder 中使用“放回原处”即可还原。"}}}},
    "This moves the source audio to the Trash. Nothing is deleted, and the Finder's Put Back restores it." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Damit wird die Originalaufnahme in den Papierkorb gelegt. Nichts wird gelöscht, und „Zurücklegen“ im Finder stellt sie wieder her."}},"en":{"stringUnit":{"state":"needs_review","value":"This moves the source audio to the Trash. Nothing is deleted, and the Finder's Put Back restores it."}},"es":{"stringUnit":{"state":"translated","value":"Esto mueve el audio original a la papelera. No se elimina nada, y «Devolver» en el Finder lo restaura."}},"fr":{"stringUnit":{"state":"translated","value":"Cela déplace l’audio source vers la corbeille. Rien n’est supprimé, et « Remettre » dans le Finder le restaure."}},"it":{"stringUnit":{"state":"needs_review","value":"Sposta nel cestino l'audio di origine. Non viene eliminato nulla e «Rimetti a posto» nel Finder lo ripristina."}},"ja":{"stringUnit":{"state":"translated","value":"元の音声をゴミ箱に移動します。何も削除されず、Finder の「戻す」で元に戻せます。"}},"ko":{"stringUnit":{"state":"needs_review","value":"원본 오디오를 휴지통으로 옮깁니다. 아무것도 삭제하지 않으며 Finder의 '되돌려놓기'로 복구할 수 있습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Isto move o áudio de origem para a lixeira. Nada é apagado, e «Repor» no Finder restaura-o."}},"ru":{"stringUnit":{"state":"translated","value":"Исходная запись будет перемещена в корзину. Ничего не удаляется, и команда «Положить обратно» в Finder её восстановит."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会将源音频移到垃圾箱。不会删除任何内容，在 Finder 中使用“放回原处”即可还原。"}}}},
    "This moves the run output to the Trash. Nothing is deleted, and the Finder's Put Back restores it." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Damit wird die Run-Ausgabe in den Papierkorb gelegt. Nichts wird gelöscht, und „Zurücklegen“ im Finder stellt sie wieder her."}},"en":{"stringUnit":{"state":"needs_review","value":"This moves the run output to the Trash. Nothing is deleted, and the Finder's Put Back restores it."}},"es":{"stringUnit":{"state":"translated","value":"Esto mueve la salida de la ejecución a la papelera. No se elimina nada, y «Devolver» en el Finder la restaura."}},"fr":{"stringUnit":{"state":"translated","value":"Cela déplace la sortie de l’exécution vers la corbeille. Rien n’est supprimé, et « Remettre » dans le Finder la restaure."}},"it":{"stringUnit":{"state":"needs_review","value":"Sposta nel cestino l'output dell'esecuzione. Non viene eliminato nulla e «Rimetti a posto» nel Finder lo ripristina."}},"ja":{"stringUnit":{"state":"translated","value":"実行結果をゴミ箱に移動します。何も削除されず、Finder の「戻す」で元に戻せます。"}},"ko":{"stringUnit":{"state":"needs_review","value":"실행 결과를 휴지통으로 옮깁니다. 아무것도 삭제하지 않으며 Finder의 '되돌려놓기'로 복구할 수 있습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Isto move a saída da execução para a lixeira. Nada é apagado, e «Repor» no Finder restaura-a."}},"ru":{"stringUnit":{"state":"translated","value":"Результат запуска будет перемещён в корзину. Ничего не удаляется, и команда «Положить обратно» в Finder его восстановит."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这会将运行输出移到垃圾箱。不会删除任何内容，在 Finder 中使用“放回原处”即可还原。"}}}},
    "The files this recording named are no longer on disk, so this removes its library entry and nothing else." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Dateien dieser Aufnahme liegen nicht mehr auf der Festplatte; entfernt wird daher nur ihr Bibliothekseintrag."}},"en":{"stringUnit":{"state":"needs_review","value":"The files this recording named are no longer on disk, so this removes its library entry and nothing else."}},"es":{"stringUnit":{"state":"translated","value":"Los archivos de esta grabación ya no están en el disco, así que esto elimina solo su entrada en la biblioteca."}},"fr":{"stringUnit":{"state":"translated","value":"Les fichiers de cet enregistrement ne sont plus sur le disque ; seule son entrée dans la bibliothèque est retirée."}},"it":{"stringUnit":{"state":"needs_review","value":"I file di questa registrazione non sono più sul disco, quindi viene rimossa solo la sua voce nell'archivio."}},"ja":{"stringUnit":{"state":"translated","value":"この録音のファイルはディスク上にないため、ライブラリの項目だけを削除します。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 녹음의 파일이 디스크에 없으므로 라이브러리 항목만 제거합니다."}},"pt":{"stringUnit":{"state":"translated","value":"Os ficheiros desta gravação já não estão no disco, por isso é removida apenas a sua entrada na biblioteca."}},"ru":{"stringUnit":{"state":"translated","value":"Файлов этой записи больше нет на диске, поэтому удаляется только её запись в библиотеке."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此录音的文件已不在磁盘上，因此仅移除其资料库条目。"}}}},
    "Wait for this recording's transcription to finish before moving it to the Trash." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Warten Sie, bis die Transkription dieser Aufnahme abgeschlossen ist, bevor Sie sie in den Papierkorb legen."}},"en":{"stringUnit":{"state":"needs_review","value":"Wait for this recording's transcription to finish before moving it to the Trash."}},"es":{"stringUnit":{"state":"translated","value":"Espera a que termine la transcripción de esta grabación antes de moverla a la papelera."}},"fr":{"stringUnit":{"state":"translated","value":"Attendez la fin de la transcription de cet enregistrement avant de le déplacer vers la corbeille."}},"it":{"stringUnit":{"state":"needs_review","value":"Attendi il completamento della trascrizione di questa registrazione prima di spostarla nel cestino."}},"ja":{"stringUnit":{"state":"translated","value":"この録音の文字起こしが完了してからゴミ箱に移動してください。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 녹음의 전사가 끝난 뒤에 휴지통으로 옮기세요."}},"pt":{"stringUnit":{"state":"translated","value":"Aguarde que a transcrição desta gravação termine antes de a mover para a lixeira."}},"ru":{"stringUnit":{"state":"translated","value":"Дождитесь завершения расшифровки этой записи, прежде чем перемещать её в корзину."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请等待此录音的转写完成后再移到垃圾箱。"}}}},
    "%@ is no longer where the library expects it, so nothing was moved." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ befindet sich nicht mehr dort, wo die Bibliothek es erwartet; es wurde nichts verschoben."}},"en":{"stringUnit":{"state":"needs_review","value":"%@ is no longer where the library expects it, so nothing was moved."}},"es":{"stringUnit":{"state":"translated","value":"%@ ya no está donde la biblioteca lo espera, así que no se movió nada."}},"fr":{"stringUnit":{"state":"translated","value":"%@ ne se trouve plus là où la bibliothèque l’attend ; rien n’a été déplacé."}},"it":{"stringUnit":{"state":"needs_review","value":"%@ non si trova più dove l'archivio se lo aspetta, quindi non è stato spostato nulla."}},"ja":{"stringUnit":{"state":"translated","value":"%@ はライブラリが想定する場所にないため、何も移動しませんでした。"}},"ko":{"stringUnit":{"state":"needs_review","value":"%@이(가) 라이브러리가 기대한 위치에 없어 아무것도 옮기지 않았습니다."}},"pt":{"stringUnit":{"state":"translated","value":"%@ já não está onde a biblioteca espera, por isso nada foi movido."}},"ru":{"stringUnit":{"state":"translated","value":"%@ больше не находится там, где ожидает библиотека, поэтому ничего не перемещено."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 已不在资料库预期的位置，因此未移动任何内容。"}}}},
    "%@ could not be moved because its folder is not writable. Nothing was moved." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ konnte nicht verschoben werden, weil sein Ordner nicht beschreibbar ist. Es wurde nichts verschoben."}},"en":{"stringUnit":{"state":"needs_review","value":"%@ could not be moved because its folder is not writable. Nothing was moved."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo mover %@ porque su carpeta no admite escritura. No se movió nada."}},"fr":{"stringUnit":{"state":"translated","value":"%@ n’a pas pu être déplacé car son dossier n’est pas accessible en écriture. Rien n’a été déplacé."}},"it":{"stringUnit":{"state":"needs_review","value":"Impossibile spostare %@ perché la sua cartella non è scrivibile. Non è stato spostato nulla."}},"ja":{"stringUnit":{"state":"translated","value":"%@ のフォルダに書き込めないため移動できませんでした。何も移動していません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"%@의 폴더에 쓸 수 없어 옮기지 못했습니다. 아무것도 옮기지 않았습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Não foi possível mover %@ porque a sua pasta não permite escrita. Nada foi movido."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось переместить %@: его папка недоступна для записи. Ничего не перемещено."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法移动 %@，因为其所在文件夹不可写入。未移动任何内容。"}}}},
    "%@ could not be moved to the Trash. Its files are where they were, and the recording is still in your library." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ konnte nicht in den Papierkorb gelegt werden. Die Dateien liegen unverändert an ihrem Platz, und die Aufnahme bleibt in der Bibliothek."}},"en":{"stringUnit":{"state":"needs_review","value":"%@ could not be moved to the Trash. Its files are where they were, and the recording is still in your library."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo mover %@ a la papelera. Sus archivos siguen donde estaban y la grabación sigue en la biblioteca."}},"fr":{"stringUnit":{"state":"translated","value":"%@ n’a pas pu être déplacé vers la corbeille. Ses fichiers sont restés en place et l’enregistrement reste dans la bibliothèque."}},"it":{"stringUnit":{"state":"needs_review","value":"Impossibile spostare %@ nel cestino. I suoi file sono rimasti dov'erano e la registrazione è ancora nell'archivio."}},"ja":{"stringUnit":{"state":"translated","value":"%@ をゴミ箱に移動できませんでした。ファイルは元の場所のままで、録音はライブラリに残っています。"}},"ko":{"stringUnit":{"state":"needs_review","value":"%@을(를) 휴지통으로 옮기지 못했습니다. 파일은 원래 자리에 그대로 있고 녹음도 라이브러리에 남아 있습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Não foi possível mover %@ para a lixeira. Os ficheiros continuam onde estavam e a gravação permanece na biblioteca."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось переместить %@ в корзину. Файлы остались на месте, а запись по-прежнему в библиотеке."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法将 %@ 移到垃圾箱。其文件仍在原处，录音也仍在资料库中。"}}}},
    "%@ could not be moved to the Trash, and part of it is in the Trash now. Put it back in the Finder. The recording is still in your library." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ konnte nicht vollständig in den Papierkorb gelegt werden; ein Teil liegt jetzt dort. Legen Sie ihn im Finder zurück. Die Aufnahme bleibt in der Bibliothek."}},"en":{"stringUnit":{"state":"needs_review","value":"%@ could not be moved to the Trash, and part of it is in the Trash now. Put it back in the Finder. The recording is still in your library."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo mover %@ a la papelera y una parte está ahora allí. Devuélvela desde el Finder. La grabación sigue en la biblioteca."}},"fr":{"stringUnit":{"state":"translated","value":"%@ n’a pas pu être déplacé vers la corbeille et une partie s’y trouve à présent. Remettez-la en place dans le Finder. L’enregistrement reste dans la bibliothèque."}},"it":{"stringUnit":{"state":"needs_review","value":"Impossibile spostare %@ nel cestino e una parte si trova ora lì. Rimettila a posto nel Finder. La registrazione è ancora nell'archivio."}},"ja":{"stringUnit":{"state":"translated","value":"%@ をゴミ箱に移動できず、一部だけがゴミ箱にあります。Finder の「戻す」で元に戻してください。録音はライブラリに残っています。"}},"ko":{"stringUnit":{"state":"needs_review","value":"%@을(를) 휴지통으로 옮기지 못했고 일부만 휴지통에 있습니다. Finder에서 되돌려놓으세요. 녹음은 라이브러리에 남아 있습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Não foi possível mover %@ para a lixeira e parte dela está agora lá. Reponha-a no Finder. A gravação permanece na biblioteca."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось переместить %@ в корзину, часть файлов уже там. Верните их через Finder. Запись по-прежнему в библиотеке."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"无法将 %@ 移到垃圾箱，其中一部分现已在垃圾箱中。请在 Finder 中放回原处。录音仍在资料库中。"}}}},
    "%@ The system reported: %@" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ Das System meldete: %@"}},"en":{"stringUnit":{"state":"needs_review","value":"%@ The system reported: %@"}},"es":{"stringUnit":{"state":"translated","value":"%@ El sistema informó: %@"}},"fr":{"stringUnit":{"state":"translated","value":"%@ Le système a signalé : %@"}},"it":{"stringUnit":{"state":"needs_review","value":"%@ Il sistema ha segnalato: %@"}},"ja":{"stringUnit":{"state":"translated","value":"%@ システムからの報告: %@"}},"ko":{"stringUnit":{"state":"needs_review","value":"%@ 시스템 보고: %@"}},"pt":{"stringUnit":{"state":"translated","value":"%@ O sistema comunicou: %@"}},"ru":{"stringUnit":{"state":"translated","value":"%@ Система сообщила: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 系统报告：%@"}}}},
    "Speaker Proposal" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprechervorschlag"}},"en":{"stringUnit":{"state":"needs_review","value":"Speaker Proposal"}},"es":{"stringUnit":{"state":"translated","value":"Propuesta de hablante"}},"fr":{"stringUnit":{"state":"translated","value":"Proposition de locuteur"}},"it":{"stringUnit":{"state":"needs_review","value":"Proposta di parlante"}},"ja":{"stringUnit":{"state":"translated","value":"話者の提案"}},"ko":{"stringUnit":{"state":"needs_review","value":"화자 제안"}},"pt":{"stringUnit":{"state":"translated","value":"Proposta de falante"}},"ru":{"stringUnit":{"state":"translated","value":"Предложение говорящего"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"说话人建议"}}}},
    "Renames this recording in the library only. The audio file and the run folder keep their names." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Benennt diese Aufnahme nur in der Bibliothek um. Die Audiodatei und der Run-Ordner behalten ihre Namen."}},"en":{"stringUnit":{"state":"needs_review","value":"Renames this recording in the library only. The audio file and the run folder keep their names."}},"es":{"stringUnit":{"state":"translated","value":"Cambia el nombre de esta grabación solo en la biblioteca. El archivo de audio y la carpeta de la ejecución conservan sus nombres."}},"fr":{"stringUnit":{"state":"translated","value":"Renomme cet enregistrement uniquement dans la bibliothèque. Le fichier audio et le dossier de l’exécution conservent leurs noms."}},"it":{"stringUnit":{"state":"needs_review","value":"Rinomina questa registrazione solo nell'archivio. Il file audio e la cartella dell'esecuzione mantengono i loro nomi."}},"ja":{"stringUnit":{"state":"translated","value":"この録音の名前をライブラリ内でのみ変更します。音声ファイルと実行フォルダの名前はそのままです。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 녹음의 이름을 라이브러리에서만 바꿉니다. 오디오 파일과 실행 폴더의 이름은 그대로입니다."}},"pt":{"stringUnit":{"state":"translated","value":"Muda o nome desta gravação apenas na biblioteca. O ficheiro de áudio e a pasta da execução mantêm os seus nomes."}},"ru":{"stringUnit":{"state":"translated","value":"Переименовывает эту запись только в библиотеке. Имена аудиофайла и папки запуска не меняются."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"仅在资料库中重命名此录音。音频文件与运行文件夹的名称保持不变。"}}}},
    "Move “%@” to the Trash?" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"„%@“ in den Papierkorb legen?"}},"en":{"stringUnit":{"state":"needs_review","value":"Move “%@” to the Trash?"}},"es":{"stringUnit":{"state":"translated","value":"¿Mover «%@» a la papelera?"}},"fr":{"stringUnit":{"state":"translated","value":"Déplacer « %@ » vers la corbeille ?"}},"it":{"stringUnit":{"state":"needs_review","value":"Spostare «%@» nel cestino?"}},"ja":{"stringUnit":{"state":"translated","value":"「%@」をゴミ箱に移動しますか？"}},"ko":{"stringUnit":{"state":"needs_review","value":"'%@'을(를) 휴지통으로 이동할까요?"}},"pt":{"stringUnit":{"state":"translated","value":"Mover «%@» para a lixeira?"}},"ru":{"stringUnit":{"state":"translated","value":"Переместить «%@» в корзину?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"将“%@”移到垃圾箱？"}}}},
    "Remove “%@” from the library?" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"„%@“ aus der Bibliothek entfernen?"}},"en":{"stringUnit":{"state":"needs_review","value":"Remove “%@” from the library?"}},"es":{"stringUnit":{"state":"translated","value":"¿Eliminar «%@» de la biblioteca?"}},"fr":{"stringUnit":{"state":"translated","value":"Retirer « %@ » de la bibliothèque ?"}},"it":{"stringUnit":{"state":"needs_review","value":"Rimuovere «%@» dall'archivio?"}},"ja":{"stringUnit":{"state":"translated","value":"「%@」をライブラリから削除しますか？"}},"ko":{"stringUnit":{"state":"needs_review","value":"'%@'을(를) 라이브러리에서 제거할까요?"}},"pt":{"stringUnit":{"state":"translated","value":"Remover «%@» da biblioteca?"}},"ru":{"stringUnit":{"state":"translated","value":"Удалить «%@» из библиотеки?"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"从资料库中移除“%@”？"}}}},
    "The top speakers held the same time in this segment, to within a nanosecond." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"In diesem Segment hielten die führenden Sprecher bis auf eine Nanosekunde gleich lange das Wort."}},"en":{"stringUnit":{"state":"needs_review","value":"The top speakers held the same time in this segment, to within a nanosecond."}},"es":{"stringUnit":{"state":"translated","value":"En este segmento, los hablantes principales ocuparon el mismo tiempo, con un margen de un nanosegundo."}},"fr":{"stringUnit":{"state":"translated","value":"Dans ce segment, les principaux locuteurs ont occupé le même temps, à une nanoseconde près."}},"it":{"stringUnit":{"state":"needs_review","value":"In questo segmento i parlanti in testa hanno occupato lo stesso tempo, a meno di un nanosecondo."}},"ja":{"stringUnit":{"state":"translated","value":"このセグメントでは上位の話者が1ナノ秒の差もなく同じ長さを占めています。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 구간에서 상위 화자들이 1나노초 차이 이내로 같은 시간을 차지했습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Neste segmento, os falantes principais ocuparam o mesmo tempo, com uma margem de um nanossegundo."}},"ru":{"stringUnit":{"state":"translated","value":"В этом сегменте ведущие говорящие занимали одинаковое время с точностью до наносекунды."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"在此片段中，居前的说话人占据的时长相同，误差不超过一纳秒。"}}}},
    "Acoustic candidates: %@" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Akustische Kandidaten: %@"}},"en":{"stringUnit":{"state":"needs_review","value":"Acoustic candidates: %@"}},"es":{"stringUnit":{"state":"translated","value":"Candidatos acústicos: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Candidats acoustiques : %@"}},"it":{"stringUnit":{"state":"needs_review","value":"Candidati acustici: %@"}},"ja":{"stringUnit":{"state":"translated","value":"音響候補: %@"}},"ko":{"stringUnit":{"state":"needs_review","value":"음향 후보: %@"}},"pt":{"stringUnit":{"state":"translated","value":"Candidatos acústicos: %@"}},"ru":{"stringUnit":{"state":"translated","value":"Акустические кандидаты: %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"声学候选说话人：%@"}}}},
    "%@ is in the Trash, but the library could not be saved, so the recording is still listed. Put it back in the Finder." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ befindet sich im Papierkorb, aber die Bibliothek konnte nicht gespeichert werden, sodass die Aufnahme weiterhin aufgeführt ist. Legen Sie sie im Finder zurück."}},"en":{"stringUnit":{"state":"needs_review","value":"%@ is in the Trash, but the library could not be saved, so the recording is still listed. Put it back in the Finder."}},"es":{"stringUnit":{"state":"translated","value":"%@ está en la Papelera, pero no se pudo guardar la biblioteca, así que la grabación sigue en la lista. Devuélvela desde el Finder."}},"fr":{"stringUnit":{"state":"translated","value":"%@ est dans la corbeille, mais la bibliothèque n'a pas pu être enregistrée, donc l'enregistrement reste dans la liste. Remettez-le en place dans le Finder."}},"it":{"stringUnit":{"state":"needs_review","value":"%@ è nel Cestino, ma non è stato possibile salvare la libreria, quindi la registrazione resta in elenco. Rimettila a posto nel Finder."}},"ja":{"stringUnit":{"state":"translated","value":"%@ はゴミ箱にありますが、ライブラリを保存できなかったため、この録音は一覧に残っています。Finder で元に戻してください。"}},"ko":{"stringUnit":{"state":"needs_review","value":"%@ 항목이 휴지통에 있지만 라이브러리를 저장하지 못해 녹음이 목록에 남아 있습니다. Finder에서 되돌려 놓으세요."}},"pt":{"stringUnit":{"state":"translated","value":"%@ está no Lixo, mas não foi possível salvar a biblioteca, então a gravação continua listada. Coloque-o de volta no Finder."}},"ru":{"stringUnit":{"state":"translated","value":"%@ находится в Корзине, но библиотеку не удалось сохранить, поэтому запись осталась в списке. Верните её на место в Finder."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%@ 已在废纸篓中，但资源库未能保存，因此该录音仍在列表中。请在“访达”中将其放回原处。"}}}}
  },
  "version" : "1.0"
}

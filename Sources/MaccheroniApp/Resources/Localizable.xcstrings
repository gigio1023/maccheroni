    "Part of this recording was transcribed and the rest produced no text." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ein Teil dieser Aufnahme wurde transkribiert, der Rest lieferte keinen Text."}},"en":{"stringUnit":{"state":"needs_review","value":"Part of this recording was transcribed and the rest produced no text."}},"es":{"stringUnit":{"state":"translated","value":"Se transcribió una parte de esta grabación y el resto no produjo texto."}},"fr":{"stringUnit":{"state":"translated","value":"Une partie de cet enregistrement a été transcrite et le reste n’a produit aucun texte."}},"it":{"stringUnit":{"state":"needs_review","value":"Una parte di questa registrazione è stata trascritta, il resto non ha prodotto testo."}},"ja":{"stringUnit":{"state":"translated","value":"この録音の一部だけが文字起こしされ、残りはテキストを生成しませんでした。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 녹음의 일부만 전사되었고 나머지는 텍스트를 내놓지 못했습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Parte desta gravação foi transcrita e o restante não produziu texto."}},"ru":{"stringUnit":{"state":"translated","value":"Часть этой записи расшифрована, остальное не дало текста."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"这段录音只有一部分被转录，其余部分没有产生文本。"}}}},

    },
    "The transcription engine finished without a run directory." : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Die Transkriptions-Engine wurde ohne Ausführungsverzeichnis beendet."}},"en":{"stringUnit":{"state":"needs_review","value":"The transcription engine finished without a run directory."}},"es":{"stringUnit":{"state":"translated","value":"El motor de transcripción finalizó sin un directorio de ejecución."}},"fr":{"stringUnit":{"state":"translated","value":"Le moteur de transcription s'est terminé sans répertoire d'exécution."}},"it":{"stringUnit":{"state":"needs_review","value":"Il motore di trascrizione è terminato senza una directory di esecuzione."}},"ja":{"stringUnit":{"state":"translated","value":"転写エンジンは実行ディレクトリなしで終了しました。"}},"ko":{"stringUnit":{"state":"needs_review","value":"실행 디렉터리 없이 전사 엔진이 완료되었습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O mecanismo de transcrição terminou sem um diretório de execução."}},"ru":{"stringUnit":{"state":"translated","value":"Механизм транскрипции завершил работу без каталога запуска."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"转录引擎在没有运行目录的情况下完成。"}}}
    },
    "There is no active recording." : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Es gibt keine aktive Aufzeichnung."}},"en":{"stringUnit":{"state":"needs_review","value":"There is no active recording."}},"es":{"stringUnit":{"state":"translated","value":"No hay ninguna grabación activa."}},"fr":{"stringUnit":{"state":"translated","value":"Il n'y a pas d'enregistrement actif."}},"it":{"stringUnit":{"state":"needs_review","value":"Non c'è alcuna registrazione attiva."}},"ja":{"stringUnit":{"state":"translated","value":"アクティブな録音はありません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"활성 녹음이 없습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Não há gravação ativa."}},"ru":{"stringUnit":{"state":"translated","value":"Активной записи нет."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有活动录音。"}}}
    },
    "•" : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"•"}},"en":{"stringUnit":{"state":"needs_review","value":"•"}},"es":{"stringUnit":{"state":"translated","value":"•"}},"fr":{"stringUnit":{"state":"translated","value":"•"}},"it":{"stringUnit":{"state":"needs_review","value":"•"}},"ja":{"stringUnit":{"state":"translated","value":"•"}},"ko":{"stringUnit":{"state":"needs_review","value":"•"}},"pt":{"stringUnit":{"state":"translated","value":"•"}},"ru":{"stringUnit":{"state":"translated","value":"•"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"•"}}}
    },
    "This run reached the MOSS output limit after bounded splitting. Choose a different profile or use a shorter copy before retrying." : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Dieser Durchlauf hat auch nach der begrenzten Aufteilung das Ausgabelimit von MOSS erreicht. Wählen Sie vor dem erneuten Versuch ein anderes Profil oder verwenden Sie eine kürzere Kopie."}},"en":{"stringUnit":{"state":"needs_review","value":"This run reached the MOSS output limit after bounded splitting. Choose a different profile or use a shorter copy before retrying."}},"es":{"stringUnit":{"state":"translated","value":"Esta ejecución alcanzó el límite de salida de MOSS incluso después de la división controlada. Elige otro perfil o usa una copia más corta antes de volver a intentarlo."}},"fr":{"stringUnit":{"state":"translated","value":"Cette exécution a atteint la limite de sortie de MOSS malgré la division limitée. Choisissez un autre profil ou utilisez une copie plus courte avant de réessayer."}},"it":{"stringUnit":{"state":"needs_review","value":"Questa esecuzione ha raggiunto il limite di output di MOSS anche dopo la suddivisione controllata. Scegli un profilo diverso o usa una copia più breve prima di riprovare."}},"ja":{"stringUnit":{"state":"translated","value":"この実行は、上限を設けた分割後も MOSS の出力上限に達しました。再試行する前に別のプロファイルを選ぶか、より短いコピーを使用してください。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 실행은 제한된 분할 처리 후에도 MOSS 출력 한도에 도달했습니다. 다른 프로필을 선택하거나 더 짧은 사본을 사용한 후 다시 시도하세요."}},"pt":{"stringUnit":{"state":"translated","value":"Esta execução atingiu o limite de saída do MOSS mesmo após a divisão limitada. Escolha outro perfil ou use uma cópia mais curta antes de tentar novamente."}},"ru":{"stringUnit":{"state":"translated","value":"Этот запуск достиг лимита вывода MOSS даже после ограниченного разделения. Перед повторной попыткой выберите другой профиль или используйте более короткую копию."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"此次运行经过受限拆分后仍达到 MOSS 输出上限。请在重试前选择其他配置文件或使用更短的副本。"}}}
    },
    "Review Profiles" : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Profile prüfen"}},"en":{"stringUnit":{"state":"needs_review","value":"Review Profiles"}},"es":{"stringUnit":{"state":"translated","value":"Revisar perfiles"}},"fr":{"stringUnit":{"state":"translated","value":"Consulter les profils"}},"it":{"stringUnit":{"state":"needs_review","value":"Esamina i profili"}},"ja":{"stringUnit":{"state":"translated","value":"プロファイルを確認"}},"ko":{"stringUnit":{"state":"needs_review","value":"프로필 검토"}},"pt":{"stringUnit":{"state":"translated","value":"Revisar perfis"}},"ru":{"stringUnit":{"state":"translated","value":"Просмотреть профили"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"查看配置文件"}}}
    },
    "Transcription Limit Reached" : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Transkriptionslimit erreicht"}},"en":{"stringUnit":{"state":"needs_review","value":"Transcription Limit Reached"}},"es":{"stringUnit":{"state":"translated","value":"Límite de transcripción alcanzado"}},"fr":{"stringUnit":{"state":"translated","value":"Limite de transcription atteinte"}},"it":{"stringUnit":{"state":"needs_review","value":"Limite di trascrizione raggiunto"}},"ja":{"stringUnit":{"state":"translated","value":"文字起こしの上限に達しました"}},"ko":{"stringUnit":{"state":"needs_review","value":"전사 한도에 도달했습니다"}},"pt":{"stringUnit":{"state":"translated","value":"Limite de transcrição atingido"}},"ru":{"stringUnit":{"state":"translated","value":"Достигнут лимит транскрипции"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"已达到转录限制"}}}
    },
    "An identical retry is disabled because it would use the same model, glossary, and chunk policy." : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Ein identischer Wiederholungsversuch ist deaktiviert, da er dasselbe Modell, Glossar und dieselbe Chunk-Richtlinie verwenden würde."}},"en":{"stringUnit":{"state":"needs_review","value":"An identical retry is disabled because it would use the same model, glossary, and chunk policy."}},"es":{"stringUnit":{"state":"translated","value":"Se deshabilitó un reintento idéntico porque usaría el mismo modelo, glosario y política de fragmentación."}},"fr":{"stringUnit":{"state":"translated","value":"Une nouvelle tentative identique est désactivée, car elle utiliserait le même modèle, glossaire et la même politique de découpage."}},"it":{"stringUnit":{"state":"needs_review","value":"Un nuovo tentativo identico è disabilitato perché userebbe lo stesso modello, glossario e criterio di suddivisione."}},"ja":{"stringUnit":{"state":"translated","value":"同一のモデル、用語集、チャンク方針を使用するため、同じ設定での再試行は無効です。"}},"ko":{"stringUnit":{"state":"needs_review","value":"동일한 모델, 용어집, 청크 정책을 사용하므로 같은 설정으로 다시 시도할 수 없습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Uma nova tentativa idêntica está desativada porque usaria o mesmo modelo, glossário e política de divisão em blocos."}},"ru":{"stringUnit":{"state":"translated","value":"Повтор с теми же настройками отключён, так как использовал бы ту же модель, глоссарий и политику разбиения на фрагменты."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"由于会使用相同的模型、术语表和分块策略，已禁用完全相同的重试。"}}}
    },
    "Inspect the preserved run. For a new attempt, choose a different profile or transcribe a shorter copy. The original recording stays unchanged." : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Prüfen Sie den erhaltenen Durchlauf. Wählen Sie für einen neuen Versuch ein anderes Profil oder transkribieren Sie eine kürzere Kopie. Die Originalaufnahme bleibt unverändert."}},"en":{"stringUnit":{"state":"needs_review","value":"Inspect the preserved run. For a new attempt, choose a different profile or transcribe a shorter copy. The original recording stays unchanged."}},"es":{"stringUnit":{"state":"translated","value":"Inspecciona la ejecución conservada. Para un nuevo intento, elige otro perfil o transcribe una copia más corta. La grabación original no cambia."}},"fr":{"stringUnit":{"state":"translated","value":"Inspectez l’exécution conservée. Pour une nouvelle tentative, choisissez un autre profil ou transcrivez une copie plus courte. L’enregistrement d’origine reste inchangé."}},"it":{"stringUnit":{"state":"needs_review","value":"Esamina l'esecuzione conservata. Per un nuovo tentativo, scegli un profilo diverso o trascrivi una copia più breve. La registrazione originale rimane invariata."}},"ja":{"stringUnit":{"state":"translated","value":"保存された実行を確認してください。新しく試す場合は、別のプロファイルを選ぶか、より短いコピーを文字起こししてください。元の録音は変更されません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"보존된 실행을 확인하세요. 새로 시도하려면 다른 프로필을 선택하거나 더 짧은 사본을 전사하세요. 원본 녹음은 그대로 유지됩니다."}},"pt":{"stringUnit":{"state":"translated","value":"Inspecione a execução preservada. Para uma nova tentativa, escolha outro perfil ou transcreva uma cópia mais curta. A gravação original permanece inalterada."}},"ru":{"stringUnit":{"state":"translated","value":"Просмотрите сохранённый запуск. Для новой попытки выберите другой профиль или расшифруйте более короткую копию. Исходная запись останется без изменений."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"请检查已保留的运行记录。如需重新尝试，请选择其他配置文件或转录更短的副本。原始录音保持不变。"}}}
    },
    "Failure Details" : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Fehlerdetails"}},"en":{"stringUnit":{"state":"needs_review","value":"Failure Details"}},"es":{"stringUnit":{"state":"translated","value":"Detalles del fallo"}},"fr":{"stringUnit":{"state":"translated","value":"Détails de l’échec"}},"it":{"stringUnit":{"state":"needs_review","value":"Dettagli dell'errore"}},"ja":{"stringUnit":{"state":"translated","value":"失敗の詳細"}},"ko":{"stringUnit":{"state":"needs_review","value":"실패 세부 정보"}},"pt":{"stringUnit":{"state":"translated","value":"Detalhes da falha"}},"ru":{"stringUnit":{"state":"translated","value":"Сведения об ошибке"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"失败详情"}}}
    },
    "%lld bytes" : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"%lld Byte"}},"en":{"stringUnit":{"state":"needs_review","value":"%lld bytes"}},"es":{"stringUnit":{"state":"translated","value":"%lld bytes"}},"fr":{"stringUnit":{"state":"translated","value":"%lld octets"}},"it":{"stringUnit":{"state":"needs_review","value":"%lld byte"}},"ja":{"stringUnit":{"state":"translated","value":"%lld バイト"}},"ko":{"stringUnit":{"state":"needs_review","value":"%lld바이트"}},"pt":{"stringUnit":{"state":"translated","value":"%lld bytes"}},"ru":{"stringUnit":{"state":"translated","value":"%lld байт"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"%lld 字节"}}}
    },
    "A new setup selects Codex only when its CLI is signed in; otherwise it selects Local. Codex receives transcript text only. Audio never leaves this Mac." : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Bei einer neuen Einrichtung wird Codex nur ausgewählt, wenn die CLI angemeldet ist; andernfalls wird Local ausgewählt. Codex erhält nur Transkripttext. Audio verlässt diesen Mac nie."}},"en":{"stringUnit":{"state":"needs_review","value":"A new setup selects Codex only when its CLI is signed in; otherwise it selects Local. Codex receives transcript text only. Audio never leaves this Mac."}},"es":{"stringUnit":{"state":"translated","value":"Una configuración nueva selecciona Codex solo si su CLI ha iniciado sesión; de lo contrario selecciona Local. Codex recibe únicamente el texto de la transcripción. El audio nunca sale de este Mac."}},"fr":{"stringUnit":{"state":"translated","value":"Une nouvelle configuration sélectionne Codex uniquement si son CLI est connecté; sinon elle sélectionne Local. Codex reçoit uniquement le texte de la transcription. L’audio ne quitte jamais ce Mac."}},"it":{"stringUnit":{"state":"needs_review","value":"Una nuova configurazione seleziona Codex solo se la sua CLI ha effettuato l'accesso; altrimenti seleziona Local. Codex riceve solo il testo della trascrizione. L'audio non lascia mai questo Mac."}},"ja":{"stringUnit":{"state":"translated","value":"新しい設定では、CLI にサインインしている場合にのみ Codex が選択されます。そうでない場合は Local が選択されます。Codex が受け取るのはトランスクリプトのテキストのみです。音声がこの Mac から出ることはありません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"새로 설정하면 Codex CLI에 로그인한 경우에만 Codex를 선택합니다. 그렇지 않으면 Local을 선택합니다. Codex는 전사문 텍스트만 받습니다. 오디오는 이 Mac을 떠나지 않습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Uma nova configuração seleciona Codex somente quando a CLI está autenticada; caso contrário, seleciona Local. Codex recebe apenas o texto da transcrição. O áudio nunca sai deste Mac."}},"ru":{"stringUnit":{"state":"translated","value":"Новая настройка выбирает Codex только при входе в CLI; иначе выбирается Local. Codex получает только текст расшифровки. Аудио никогда не покидает этот Mac."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"新设置仅在 Codex CLI 已登录时选择 Codex；否则选择 Local。Codex 仅接收转录文本。音频绝不会离开这台 Mac。"}}}
    },
    "Audio stays on this Mac. Transcription runs locally; Codex receives transcript text only during post-processing." : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Audio bleibt auf diesem Mac. Die Transkription läuft lokal; Codex erhält nur während der Nachbearbeitung Transkripttext."}},"en":{"stringUnit":{"state":"needs_review","value":"Audio stays on this Mac. Transcription runs locally; Codex receives transcript text only during post-processing."}},"es":{"stringUnit":{"state":"translated","value":"El audio permanece en este Mac. La transcripción se ejecuta localmente; Codex recibe texto de la transcripción solo durante el posprocesamiento."}},"fr":{"stringUnit":{"state":"translated","value":"L’audio reste sur ce Mac. La transcription s’exécute localement; Codex reçoit le texte de la transcription uniquement lors du post-traitement."}},"it":{"stringUnit":{"state":"needs_review","value":"L'audio resta su questo Mac. La trascrizione viene eseguita localmente; Codex riceve il testo della trascrizione solo durante il post-processing."}},"ja":{"stringUnit":{"state":"translated","value":"音声はこの Mac にとどまります。文字起こしはローカルで実行され、Codex がトランスクリプトのテキストを受け取るのは後処理中のみです。"}},"ko":{"stringUnit":{"state":"needs_review","value":"오디오는 이 Mac에 남습니다. 전사는 로컬에서 실행되며 Codex는 후처리할 때만 전사문 텍스트를 받습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O áudio permanece neste Mac. A transcrição é executada localmente; Codex recebe texto da transcrição apenas durante o pós-processamento."}},"ru":{"stringUnit":{"state":"translated","value":"Аудио остаётся на этом Mac. Расшифровка выполняется локально; Codex получает текст расшифровки только во время постобработки."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"音频保留在这台 Mac 上。转录在本地运行；Codex 仅在后处理期间接收转录文本。"}}}
    },
    "Batches Planned" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Geplante Batches"}},"en":{"stringUnit":{"state":"needs_review","value":"Batches Planned"}},"es":{"stringUnit":{"state":"translated","value":"Lotes planificados"}},"fr":{"stringUnit":{"state":"translated","value":"Lots planifiés"}},"it":{"stringUnit":{"state":"needs_review","value":"Batch pianificati"}},"ja":{"stringUnit":{"state":"translated","value":"予定バッチ数"}},"ko":{"stringUnit":{"state":"needs_review","value":"예정 배치 수"}},"pt":{"stringUnit":{"state":"translated","value":"Lotes planejados"}},"ru":{"stringUnit":{"state":"translated","value":"Запланированные пакеты"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"计划批次"}}}},
    "Check Again" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Erneut prüfen"}},"en":{"stringUnit":{"state":"needs_review","value":"Check Again"}},"es":{"stringUnit":{"state":"translated","value":"Comprobar de nuevo"}},"fr":{"stringUnit":{"state":"translated","value":"Vérifier à nouveau"}},"it":{"stringUnit":{"state":"needs_review","value":"Controlla di nuovo"}},"ja":{"stringUnit":{"state":"translated","value":"もう一度確認"}},"ko":{"stringUnit":{"state":"needs_review","value":"다시 확인"}},"pt":{"stringUnit":{"state":"translated","value":"Verificar novamente"}},"ru":{"stringUnit":{"state":"translated","value":"Проверить снова"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"再次检查"}}}},
    "Checking availability…" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Verfügbarkeit wird geprüft…"}},"en":{"stringUnit":{"state":"needs_review","value":"Checking availability…"}},"es":{"stringUnit":{"state":"translated","value":"Comprobando disponibilidad…"}},"fr":{"stringUnit":{"state":"translated","value":"Vérification de la disponibilité…"}},"it":{"stringUnit":{"state":"needs_review","value":"Verifica della disponibilità…"}},"ja":{"stringUnit":{"state":"translated","value":"利用可能か確認中…"}},"ko":{"stringUnit":{"state":"needs_review","value":"사용 가능 여부 확인 중…"}},"pt":{"stringUnit":{"state":"translated","value":"Verificando disponibilidade…"}},"ru":{"stringUnit":{"state":"translated","value":"Проверка доступности…"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"正在检查可用性…"}}}},
    "Chooses the language the transcript is translated into." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Wählt die Sprache, in die das Transkript übersetzt wird."}},"en":{"stringUnit":{"state":"needs_review","value":"Chooses the language the transcript is translated into."}},"es":{"stringUnit":{"state":"translated","value":"Elige el idioma al que se traduce la transcripción."}},"fr":{"stringUnit":{"state":"translated","value":"Choisit la langue dans laquelle la transcription est traduite."}},"it":{"stringUnit":{"state":"needs_review","value":"Sceglie la lingua in cui tradurre la trascrizione."}},"ja":{"stringUnit":{"state":"translated","value":"トランスクリプトの翻訳先言語を選択します。"}},"ko":{"stringUnit":{"state":"needs_review","value":"전사문을 번역할 언어를 선택합니다."}},"pt":{"stringUnit":{"state":"translated","value":"Escolhe o idioma para o qual a transcrição será traduzida."}},"ru":{"stringUnit":{"state":"translated","value":"Выбирает язык, на который будет переведена расшифровка."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"选择转录文本要翻译成的语言。"}}}},
    "Codex CLI" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Codex-CLI"}},"en":{"stringUnit":{"state":"needs_review","value":"Codex CLI"}},"es":{"stringUnit":{"state":"translated","value":"CLI de Codex"}},"fr":{"stringUnit":{"state":"translated","value":"CLI Codex"}},"it":{"stringUnit":{"state":"needs_review","value":"CLI Codex"}},"ja":{"stringUnit":{"state":"translated","value":"Codex CLI"}},"ko":{"stringUnit":{"state":"needs_review","value":"Codex CLI"}},"pt":{"stringUnit":{"state":"translated","value":"CLI do Codex"}},"ru":{"stringUnit":{"state":"translated","value":"CLI Codex"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex CLI"}}}},
    "Codex CLI was not found. Install it and run codex login in Terminal, or select Local meanwhile." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Codex-CLI wurde nicht gefunden. Installieren Sie sie und führen Sie codex login im Terminal aus, oder wählen Sie vorerst Local."}},"en":{"stringUnit":{"state":"needs_review","value":"Codex CLI was not found. Install it and run codex login in Terminal, or select Local meanwhile."}},"es":{"stringUnit":{"state":"translated","value":"No se encontró la CLI de Codex. Instálala y ejecuta codex login en Terminal, o selecciona Local mientras tanto."}},"fr":{"stringUnit":{"state":"translated","value":"Le CLI Codex est introuvable. Installez-le et exécutez codex login dans Terminal, ou sélectionnez Local entre-temps."}},"it":{"stringUnit":{"state":"needs_review","value":"La CLI di Codex non è stata trovata. Installala ed esegui codex login in Terminale, oppure seleziona Local nel frattempo."}},"ja":{"stringUnit":{"state":"translated","value":"Codex CLI が見つかりません。インストールしてターミナルで codex login を実行するか、当面は Local を選択してください。"}},"ko":{"stringUnit":{"state":"needs_review","value":"Codex CLI를 찾지 못했습니다. 설치한 다음 터미널에서 codex login을 실행하거나 그동안 Local을 선택하세요."}},"pt":{"stringUnit":{"state":"translated","value":"A CLI do Codex não foi encontrada. Instale-a e execute codex login no Terminal, ou selecione Local enquanto isso."}},"ru":{"stringUnit":{"state":"translated","value":"CLI Codex не найден. Установите его и выполните codex login в Терминале или пока выберите Local."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未找到 Codex CLI。请安装它并在终端中运行 codex login，或暂时选择 Local。"}}}},
    "Codex is installed, but its sign-in status could not be checked. Try again or select Local meanwhile." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Codex ist installiert, aber der Anmeldestatus konnte nicht überprüft werden. Versuche es erneut oder wähle vorerst Local."}},"en":{"stringUnit":{"state":"needs_review","value":"Codex is installed, but its sign-in status could not be checked. Try again or select Local meanwhile."}},"es":{"stringUnit":{"state":"translated","value":"Codex está instalado, pero no se pudo comprobar el estado de inicio de sesión. Inténtalo de nuevo o selecciona Local mientras tanto."}},"fr":{"stringUnit":{"state":"translated","value":"Codex est installé, mais son état de connexion n’a pas pu être vérifié. Réessayez ou sélectionnez Local pour le moment."}},"it":{"stringUnit":{"state":"needs_review","value":"Codex è installato, ma non è stato possibile verificarne lo stato di accesso. Riprova o seleziona Local nel frattempo."}},"ja":{"stringUnit":{"state":"translated","value":"Codex はインストールされていますが、サインイン状態を確認できませんでした。再試行するか、当面は Local を選択してください。"}},"ko":{"stringUnit":{"state":"needs_review","value":"Codex가 설치되어 있지만 로그인 상태를 확인하지 못했습니다. 다시 시도하거나 그동안 Local을 선택하세요."}},"pt":{"stringUnit":{"state":"translated","value":"O Codex está instalado, mas não foi possível verificar o estado de início de sessão. Tente novamente ou selecione Local por enquanto."}},"ru":{"stringUnit":{"state":"translated","value":"Codex установлен, но не удалось проверить состояние входа. Повторите попытку или пока выберите Local."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 已安装，但无法检查登录状态。请重试或暂时选择 Local。"}}}},
    "Codex is installed but not signed in. Run codex login in Terminal, or select Local meanwhile." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Codex ist installiert, aber nicht angemeldet. Führen Sie codex login im Terminal aus, oder wählen Sie vorerst Local."}},"en":{"stringUnit":{"state":"needs_review","value":"Codex is installed but not signed in. Run codex login in Terminal, or select Local meanwhile."}},"es":{"stringUnit":{"state":"translated","value":"Codex está instalado, pero no has iniciado sesión. Ejecuta codex login en Terminal, o selecciona Local mientras tanto."}},"fr":{"stringUnit":{"state":"translated","value":"Codex est installé, mais non connecté. Exécutez codex login dans Terminal, ou sélectionnez Local entre-temps."}},"it":{"stringUnit":{"state":"needs_review","value":"Codex è installato ma non hai effettuato l'accesso. Esegui codex login in Terminale, oppure seleziona Local nel frattempo."}},"ja":{"stringUnit":{"state":"translated","value":"Codex はインストールされていますが、サインインしていません。ターミナルで codex login を実行するか、当面は Local を選択してください。"}},"ko":{"stringUnit":{"state":"needs_review","value":"Codex는 설치되어 있지만 로그인하지 않았습니다. 터미널에서 codex login을 실행하거나 그동안 Local을 선택하세요."}},"pt":{"stringUnit":{"state":"translated","value":"Codex está instalado, mas não está autenticado. Execute codex login no Terminal ou selecione Local enquanto isso."}},"ru":{"stringUnit":{"state":"translated","value":"Codex установлен, но вход не выполнен. Выполните codex login в Терминале или пока выберите Local."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 已安装但尚未登录。请在终端中运行 codex login，或暂时选择 Local。"}}}},
    "Your Codex sign-in is expired or too close to expiry. Refresh or sign in through Codex, then retry, or select Local." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Ihre Codex-Anmeldung ist abgelaufen oder läuft zu bald ab. Aktualisieren Sie sie oder melden Sie sich über Codex an. Versuchen Sie es dann erneut oder wählen Sie Local."}},"en":{"stringUnit":{"state":"needs_review","value":"Your Codex sign-in is expired or too close to expiry. Refresh or sign in through Codex, then retry, or select Local."}},"es":{"stringUnit":{"state":"translated","value":"Tu sesión de Codex ha caducado o está demasiado cerca de caducar. Actualízala o inicia sesión mediante Codex y vuelve a intentarlo, o selecciona Local."}},"fr":{"stringUnit":{"state":"translated","value":"Votre connexion Codex a expiré ou est trop proche de l’expiration. Actualisez-la ou connectez-vous via Codex, puis réessayez ou sélectionnez Local."}},"it":{"stringUnit":{"state":"needs_review","value":"L'accesso a Codex è scaduto o è troppo vicino alla scadenza. Aggiornalo o accedi tramite Codex, quindi riprova oppure seleziona Local."}},"ja":{"stringUnit":{"state":"translated","value":"Codex のサインインは期限切れか、有効期限が近すぎます。Codex で更新またはサインインしてから再試行するか、Local を選択してください。"}},"ko":{"stringUnit":{"state":"needs_review","value":"Codex 로그인이 만료되었거나 만료 시점이 너무 가깝습니다. Codex에서 갱신하거나 로그인한 다음 다시 시도하거나 Local을 선택하세요."}},"pt":{"stringUnit":{"state":"translated","value":"A sessão do Codex expirou ou está muito próxima de expirar. Atualize-a ou inicie sessão pelo Codex e tente novamente, ou selecione Local."}},"ru":{"stringUnit":{"state":"translated","value":"Срок действия входа в Codex истёк или скоро истечёт. Обновите его или войдите через Codex, затем повторите попытку либо выберите Local."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 登录已过期或即将过期。请通过 Codex 刷新登录状态或重新登录，然后重试，或选择 Local。"}}}},
    "Codex is signed in and ready." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Codex ist angemeldet und bereit."}},"en":{"stringUnit":{"state":"needs_review","value":"Codex is signed in and ready."}},"es":{"stringUnit":{"state":"translated","value":"Codex ha iniciado sesión y está listo."}},"fr":{"stringUnit":{"state":"translated","value":"Codex est connecté et prêt."}},"it":{"stringUnit":{"state":"needs_review","value":"Codex ha effettuato l'accesso ed è pronto."}},"ja":{"stringUnit":{"state":"translated","value":"Codex はサインイン済みで使用できます。"}},"ko":{"stringUnit":{"state":"needs_review","value":"Codex에 로그인되어 사용할 수 있습니다."}},"pt":{"stringUnit":{"state":"translated","value":"O Codex está autenticado e pronto."}},"ru":{"stringUnit":{"state":"translated","value":"В Codex выполнен вход, всё готово."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Codex 已登录并可使用。"}}}},
    "Correct" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Korrigieren"}},"en":{"stringUnit":{"state":"needs_review","value":"Correct"}},"es":{"stringUnit":{"state":"translated","value":"Corregir"}},"fr":{"stringUnit":{"state":"translated","value":"Corriger"}},"it":{"stringUnit":{"state":"needs_review","value":"Correggi"}},"ja":{"stringUnit":{"state":"translated","value":"修正"}},"ko":{"stringUnit":{"state":"needs_review","value":"교정"}},"pt":{"stringUnit":{"state":"translated","value":"Corrigir"}},"ru":{"stringUnit":{"state":"translated","value":"Исправить"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"校正"}}}},

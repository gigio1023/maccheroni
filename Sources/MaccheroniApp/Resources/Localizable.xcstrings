{
  "sourceLanguage" : "en",
  "strings" : {
    "Some segments carry no recorded speaker evidence." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Für einige Segmente ist kein Sprechernachweis aufgezeichnet."}},"en":{"stringUnit":{"state":"needs_review","value":"Some segments carry no recorded speaker evidence."}},"es":{"stringUnit":{"state":"translated","value":"Algunos segmentos no tienen evidencia de hablante registrada."}},"fr":{"stringUnit":{"state":"translated","value":"Certains segments ne comportent aucune preuve de locuteur enregistrée."}},"it":{"stringUnit":{"state":"needs_review","value":"Alcuni segmenti non riportano prove sul parlante."}},"ja":{"stringUnit":{"state":"translated","value":"一部のセグメントには話者の記録された根拠がありません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"일부 구간에는 기록된 화자 근거가 없습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Alguns segmentos não têm evidência de falante registada."}},"ru":{"stringUnit":{"state":"translated","value":"Для некоторых сегментов не записаны данные о говорящем."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"部分片段没有记录任何说话人证据。"}}}},
    "%@ of speech" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ der Sprache"}},"en":{"stringUnit":{"state":"needs_review","value":"%@ of speech"}},"es":{"stringUnit":{"state":"translated","value":"%@ del habla"}},"fr":{"stringUnit":{"state":"translated","value":"%@ de la parole"}},"it":{"stringUnit":{"state":"needs_review","value":"%@ del parlato"}},"ja":{"stringUnit":{"state":"translated","value":"発話の %@"}},"ko":{"stringUnit":{"state":"needs_review","value":"발화의 %@"}},"pt":{"stringUnit":{"state":"translated","value":"%@ da fala"}},"ru":{"stringUnit":{"state":"translated","value":"%@ речи"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"占语音 %@"}}}},
    "No speaker held enough of this segment's speech, so none was named." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kein Sprecher hielt genug der Sprache dieses Segments, daher wurde keiner benannt."}},"en":{"stringUnit":{"state":"needs_review","value":"No speaker held enough of this segment's speech, so none was named."}},"es":{"stringUnit":{"state":"translated","value":"Ningún hablante alcanzó suficiente del habla de este segmento, así que no se nombró a ninguno."}},"fr":{"stringUnit":{"state":"translated","value":"Aucun locuteur n'a atteint une part suffisante de la parole de ce segment, aucun n'a donc été nommé."}},"it":{"stringUnit":{"state":"needs_review","value":"Nessun parlante ha raggiunto una quota sufficiente del parlato di questo segmento, quindi nessuno è stato indicato."}},"ja":{"stringUnit":{"state":"translated","value":"このセグメントの発話を十分に占めた話者がいないため、話者は特定されませんでした。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 구간 발화를 충분히 차지한 화자가 없어 화자를 정하지 않았습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Nenhum falante atingiu uma parte suficiente da fala deste segmento, por isso nenhum foi indicado."}},"ru":{"stringUnit":{"state":"translated","value":"Ни один говорящий не набрал достаточной доли речи этого сегмента, поэтому никто не назван."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"没有说话人占到此片段语音的足够比例，因此未确定说话人。"}}}},
    "The speaker timeline covered %@ of this segment, below what this run requires." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Die Sprecherzeitleiste deckte %@ dieses Segments ab, unter dem, was dieser Lauf verlangt."}},"en":{"stringUnit":{"state":"needs_review","value":"The speaker timeline covered %@ of this segment, below what this run requires."}},"es":{"stringUnit":{"state":"translated","value":"La línea de tiempo cubrió %@ de este segmento, por debajo de lo que esta ejecución exige."}},"fr":{"stringUnit":{"state":"translated","value":"La chronologie couvrait %@ de ce segment, sous ce que cette exécution exige."}},"it":{"stringUnit":{"state":"needs_review","value":"La timeline copriva %@ di questo segmento, sotto quanto richiede questa esecuzione."}},"ja":{"stringUnit":{"state":"translated","value":"話者タイムラインはこのセグメントの %@ しか覆っておらず、この実行が求める水準を下回ります。"}},"ko":{"stringUnit":{"state":"needs_review","value":"화자 타임라인이 이 구간의 %@만 덮어 이 실행의 기준에 못 미칩니다."}},"pt":{"stringUnit":{"state":"translated","value":"A linha do tempo cobriu %@ deste segmento, abaixo do que esta execução exige."}},"ru":{"stringUnit":{"state":"translated","value":"Шкала говорящих покрыла %@ этого сегмента, ниже требований этого запуска."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"说话人时间轴仅覆盖此片段的 %@，低于本次运行的要求。"}}}},
    "%@ of this recording produced no transcript, so these proposals cover %@ of %@." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%@ dieser Aufnahme ergaben kein Transkript, daher decken diese Vorschläge %@ von %@ ab."}},"en":{"stringUnit":{"state":"needs_review","value":"%@ of this recording produced no transcript, so these proposals cover %@ of %@."}},"es":{"stringUnit":{"state":"translated","value":"%@ de esta grabación no produjo transcripción, así que estas propuestas cubren %@ de %@."}},"fr":{"stringUnit":{"state":"translated","value":"%@ de cet enregistrement n'a produit aucune transcription ; ces propositions couvrent donc %@ sur %@."}},"it":{"stringUnit":{"state":"needs_review","value":"%@ di questa registrazione non ha prodotto trascrizione, quindi queste proposte coprono %@ su %@."}},"ja":{"stringUnit":{"state":"translated","value":"この録音のうち %@ は文字起こしが得られなかったため、これらの提案は %@ / %@ を対象としています。"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 녹음 중 %@는 전사문이 없어 이 제안은 %@ / %@만 다룹니다."}},"pt":{"stringUnit":{"state":"translated","value":"%@ desta gravação não produziu transcrição, por isso estas propostas cobrem %@ de %@."}},"ru":{"stringUnit":{"state":"translated","value":"%@ этой записи не дали расшифровки, поэтому предложения охватывают %@ из %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"本录音中有 %@ 未产生转录，因此这些建议覆盖 %@ / %@。"}}}},
    "%lld proposed, %lld declined. Not acoustic evidence, and not measured." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"%lld vorgeschlagen, %lld abgelehnt. Kein akustischer Nachweis und nicht gemessen."}},"en":{"stringUnit":{"state":"needs_review","value":"%lld proposed, %lld declined. Not acoustic evidence, and not measured."}},"es":{"stringUnit":{"state":"translated","value":"%lld propuestos, %lld rechazados. No es evidencia acústica ni una medición."}},"fr":{"stringUnit":{"state":"translated","value":"%lld proposés, %lld refusés. Ce n'est ni une preuve acoustique ni une mesure."}},"it":{"stringUnit":{"state":"needs_review","value":"%lld proposti, %lld rifiutati. Non è una prova acustica né una misurazione."}},"ja":{"stringUnit":{"state":"translated","value":"提案 %lld 件、見送り %lld 件。音響的な根拠でも計測値でもありません。"}},"ko":{"stringUnit":{"state":"needs_review","value":"제안 %lld개, 보류 %lld개. 음향 근거도 측정값도 아닙니다."}},"pt":{"stringUnit":{"state":"translated","value":"%lld propostos, %lld recusados. Não é evidência acústica nem uma medição."}},"ru":{"stringUnit":{"state":"translated","value":"Предложено %lld, отклонено %lld. Это не акустические данные и не измерение."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"建议 %lld 条，放弃 %lld 条。既非声学证据，也非测量结果。"}}}},
    "Proposed, not measured" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Vorgeschlagen, nicht gemessen"}},"en":{"stringUnit":{"state":"needs_review","value":"Proposed, not measured"}},"es":{"stringUnit":{"state":"translated","value":"Propuesto, no medido"}},"fr":{"stringUnit":{"state":"translated","value":"Proposé, non mesuré"}},"it":{"stringUnit":{"state":"needs_review","value":"Proposto, non misurato"}},"ja":{"stringUnit":{"state":"translated","value":"提案であり、計測値ではありません"}},"ko":{"stringUnit":{"state":"needs_review","value":"제안이며 측정값 아님"}},"pt":{"stringUnit":{"state":"translated","value":"Proposto, não medido"}},"ru":{"stringUnit":{"state":"translated","value":"Предложено, не измерено"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"为建议，非测量结果"}}}},
    "No speaker proposed" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Kein Sprecher vorgeschlagen"}},"en":{"stringUnit":{"state":"needs_review","value":"No speaker proposed"}},"es":{"stringUnit":{"state":"translated","value":"Sin hablante propuesto"}},"fr":{"stringUnit":{"state":"translated","value":"Aucun locuteur proposé"}},"it":{"stringUnit":{"state":"needs_review","value":"Nessun parlante proposto"}},"ja":{"stringUnit":{"state":"translated","value":"話者の提案なし"}},"ko":{"stringUnit":{"state":"needs_review","value":"제안된 화자 없음"}},"pt":{"stringUnit":{"state":"translated","value":"Nenhum falante proposto"}},"ru":{"stringUnit":{"state":"translated","value":"Говорящий не предложен"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"未提出说话人"}}}},
    "The acoustic evidence is not loaded beside a translation. The source run still has it." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Der akustische Nachweis wird neben einer Übersetzung nicht geladen. Im Quelllauf ist er weiterhin vorhanden."}},"en":{"stringUnit":{"state":"needs_review","value":"The acoustic evidence is not loaded beside a translation. The source run still has it."}},"es":{"stringUnit":{"state":"translated","value":"La evidencia acústica no se carga junto a una traducción. La ejecución de origen la conserva."}},"fr":{"stringUnit":{"state":"translated","value":"La preuve acoustique n'est pas chargée à côté d'une traduction. L'exécution source la conserve."}},"it":{"stringUnit":{"state":"needs_review","value":"La prova acustica non viene caricata accanto a una traduzione. L'esecuzione di origine la conserva."}},"ja":{"stringUnit":{"state":"translated","value":"音響的な根拠は翻訳と並べて読み込まれません。元の実行には残っています。"}},"ko":{"stringUnit":{"state":"needs_review","value":"음향 근거는 번역본과 함께 불러오지 않습니다. 원본 실행에는 그대로 있습니다."}},"pt":{"stringUnit":{"state":"translated","value":"A evidência acústica não é carregada junto de uma tradução. A execução de origem mantém-na."}},"ru":{"stringUnit":{"state":"translated","value":"Акустические данные не загружаются рядом с переводом. В исходном запуске они сохранены."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"声学证据不会与译文一同加载。源运行中仍然保留。"}}}},
    "Timeline coverage %@." : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Zeitleistenabdeckung %@."}},"en":{"stringUnit":{"state":"needs_review","value":"Timeline coverage %@."}},"es":{"stringUnit":{"state":"translated","value":"Cobertura de la línea de tiempo %@."}},"fr":{"stringUnit":{"state":"translated","value":"Couverture de la chronologie %@."}},"it":{"stringUnit":{"state":"needs_review","value":"Copertura della timeline %@."}},"ja":{"stringUnit":{"state":"translated","value":"タイムラインの被覆率は %@ です。"}},"ko":{"stringUnit":{"state":"needs_review","value":"타임라인 커버리지 %@."}},"pt":{"stringUnit":{"state":"translated","value":"Cobertura da linha do tempo %@."}},"ru":{"stringUnit":{"state":"translated","value":"Покрытие шкалы %@."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"时间轴覆盖率为 %@。"}}}},
    "Speaker %@" : {"localizations":{"de":{"stringUnit":{"state":"translated","value":"Sprecher %@"}},"en":{"stringUnit":{"state":"needs_review","value":"Speaker %@"}},"es":{"stringUnit":{"state":"translated","value":"Hablante %@"}},"fr":{"stringUnit":{"state":"translated","value":"Locuteur %@"}},"it":{"stringUnit":{"state":"needs_review","value":"Parlante %@"}},"ja":{"stringUnit":{"state":"translated","value":"話者 %@"}},"ko":{"stringUnit":{"state":"needs_review","value":"화자 %@"}},"pt":{"stringUnit":{"state":"translated","value":"Falante %@"}},"ru":{"stringUnit":{"state":"translated","value":"Говорящий %@"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"说话人 %@"}}}},

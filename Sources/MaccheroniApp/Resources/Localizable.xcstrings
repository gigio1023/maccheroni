    "MACCHERONI_LIBRARY_ROOT controls the recording and run paths for this launch." : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"MACCHERONI_LIBRARY_ROOT steuert die Aufnahme- und Ausführungspfade für diesen Start."}},"en":{"stringUnit":{"state":"needs_review","value":"MACCHERONI_LIBRARY_ROOT controls the recording and run paths for this launch."}},"es":{"stringUnit":{"state":"translated","value":"MACCHERONI_LIBRARY_ROOT controla las rutas de grabación y ejecución para este inicio."}},"fr":{"stringUnit":{"state":"translated","value":"MACCHERONI_LIBRARY_ROOT contrôle les chemins des enregistrements et des exécutions pour ce lancement."}},"it":{"stringUnit":{"state":"needs_review","value":"MACCHERONI_LIBRARY_ROOT controlla i percorsi delle registrazioni e delle esecuzioni per questo avvio."}},"ja":{"stringUnit":{"state":"translated","value":"MACCHERONI_LIBRARY_ROOT は今回の起動時の録音と実行パスを制御します。"}},"ko":{"stringUnit":{"state":"needs_review","value":"MACCHERONI_LIBRARY_ROOT는 이번 실행의 녹음과 실행 경로를 제어합니다."}},"pt":{"stringUnit":{"state":"translated","value":"MACCHERONI_LIBRARY_ROOT controla os caminhos de gravação e execução nesta inicialização."}},"ru":{"stringUnit":{"state":"translated","value":"MACCHERONI_LIBRARY_ROOT управляет путями для записей и запусков в этом сеансе."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"MACCHERONI_LIBRARY_ROOT 控制本次启动的录音和运行路径。"}}}
    },
    "Maccheroni Could Not Start" : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Maccheroni konnte nicht starten"}},"en":{"stringUnit":{"state":"needs_review","value":"Maccheroni Could Not Start"}},"es":{"stringUnit":{"state":"translated","value":"Maccheroni no pudo comenzar"}},"fr":{"stringUnit":{"state":"translated","value":"Les macaronis n'ont pas pu démarrer"}},"it":{"stringUnit":{"state":"needs_review","value":"Impossibile avviare Maccheroni"}},"ja":{"stringUnit":{"state":"translated","value":"Maccheroniを開始できませんでした"}},"ko":{"stringUnit":{"state":"needs_review","value":"Maccheroni를 시작할 수 없습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Maccheroni não pôde iniciar"}},"ru":{"stringUnit":{"state":"translated","value":"Maccheroni не удалось запустить"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Maccheroni 无法启动"}}}
    },
    "Maccheroni Needs Attention" : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Maccheroni braucht Aufmerksamkeit"}},"en":{"stringUnit":{"state":"needs_review","value":"Maccheroni Needs Attention"}},"es":{"stringUnit":{"state":"translated","value":"Maccheroni necesita atención"}},"fr":{"stringUnit":{"state":"translated","value":"Les macaronis ont besoin d’attention"}},"it":{"stringUnit":{"state":"needs_review","value":"Maccheroni richiede attenzione"}},"ja":{"stringUnit":{"state":"translated","value":"Maccheroniに注意が必要です"}},"ko":{"stringUnit":{"state":"needs_review","value":"Maccheroni를 확인해 주세요"}},"pt":{"stringUnit":{"state":"translated","value":"Maccheroni precisa de atenção"}},"ru":{"stringUnit":{"state":"translated","value":"Maccheroni требует внимания"}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Maccheroni 需要注意"}}}
    },
    "Maccheroni is processing the full recording locally." : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Maccheroni verarbeitet die gesamte Aufnahme vor Ort."}},"en":{"stringUnit":{"state":"needs_review","value":"Maccheroni is processing the full recording locally."}},"es":{"stringUnit":{"state":"translated","value":"Maccheroni está procesando la grabación completa localmente."}},"fr":{"stringUnit":{"state":"translated","value":"Maccheroni traite l'intégralité de l'enregistrement localement."}},"it":{"stringUnit":{"state":"needs_review","value":"Maccheroni sta elaborando localmente la registrazione completa."}},"ja":{"stringUnit":{"state":"translated","value":"Maccheroni は完全な録音をローカルで処理しています。"}},"ko":{"stringUnit":{"state":"needs_review","value":"Maccheroni는 전체 녹음을 로컬에서 처리하고 있습니다."}},"pt":{"stringUnit":{"state":"translated","value":"Maccheroni está processando a gravação completa localmente."}},"ru":{"stringUnit":{"state":"translated","value":"Maccheroni обрабатывает всю запись локально."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Maccheroni 正在本地处理完整的录音。"}}}
    },
    "Maccheroni never deletes or overwrites recordings, raw transcripts, or completed run artifacts. Removing a model or a recording uses the macOS Trash." : {
      "localizations" : {"de":{"stringUnit":{"state":"translated","value":"Maccheroni löscht oder überschreibt niemals Aufzeichnungen, Rohtranskripte oder Artefakte abgeschlossener Läufe. Beim Entfernen eines Modells oder einer Aufzeichnung wird der macOS-Papierkorb verwendet."}},"en":{"stringUnit":{"state":"needs_review","value":"Maccheroni never deletes or overwrites recordings, raw transcripts, or completed run artifacts. Removing a model or a recording uses the macOS Trash."}},"es":{"stringUnit":{"state":"translated","value":"Maccheroni nunca elimina ni sobrescribe grabaciones, transcripciones sin procesar ni artefactos de ejecución completos. La eliminación de un modelo o de una grabación utiliza la Papelera de macOS."}},"fr":{"stringUnit":{"state":"translated","value":"Maccheroni ne supprime ni n'écrase jamais les enregistrements, les transcriptions brutes ou les artefacts d'exécution terminés. La suppression d'un modèle ou d'un enregistrement utilise la corbeille macOS."}},"it":{"stringUnit":{"state":"needs_review","value":"Maccheroni non cancella né sovrascrive mai registrazioni, trascrizioni grezze o artefatti di esecuzione completata. La rimozione di un modello o di una registrazione utilizza il Cestino di macOS."}},"ja":{"stringUnit":{"state":"translated","value":"Maccheroni は、録音、生のトランスクリプト、または完了した実行アーティファクトを削除したり上書きしたりすることはありません。モデルや録音の削除には macOS のゴミ箱を使用します。"}},"ko":{"stringUnit":{"state":"needs_review","value":"Maccheroni는 녹음, 원시 전사문, 완료된 실행 산출물을 삭제하거나 덮어쓰지 않습니다. 모델이나 녹음을 제거하면 macOS 휴지통으로 이동합니다."}},"pt":{"stringUnit":{"state":"translated","value":"Maccheroni nunca exclui ou substitui gravações, transcrições brutas ou artefatos de execução concluídos. A remoção de um modelo ou de uma gravação usa a Lixeira do macOS."}},"ru":{"stringUnit":{"state":"translated","value":"Maccheroni никогда не удаляет и не перезаписывает записи, необработанные расшифровки или артефакты завершенного запуска. Для удаления модели или записи используется корзина macOS."}},"zh-Hans":{"stringUnit":{"state":"translated","value":"Maccheroni 绝不会删除或覆盖录音、原始记录或已完成的运行工件。删除模型或录音时使用 macOS 垃圾箱。"}}}
    },
